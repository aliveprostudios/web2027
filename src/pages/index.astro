---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import heroBg from '../../content/assets/home/hero.jpg';
import homeFeature from '../../content/assets/home/feature.jpg';
import founderPortrait from '../../content/assets/site/javad-ahmadi-portrait.jpg';
import BgRails from '../components/BgRails.astro';
import SiteNav from '../components/SiteNav.astro';
import VideoHero from '../components/VideoHero.astro';
import InlineVideo from '../components/InlineVideo.astro';
import Lightbox from '../components/Lightbox.astro';
import NextStep from '../components/NextStep.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { pillars } from '../lib/pillars';
import { parseAnatomy, splitSentences } from '../lib/anatomy';
import { figure } from '../lib/figures';
import { assetsFor } from '../lib/caseStudies';

/**
 * Home page.
 *
 * This is the page built as "Home-B" on 2026-09-01 and promoted to the home
 * route the same day at Javad's direction, replacing the launch-day home
 * page. Its content lives in `content/home/` (`page.md` and `intro.md`)
 * through the `home` collection, so every string here is editable without
 * opening this file, and its imagery in `content/assets/home/`.
 *
 * Order: 1 Hero · 2 How We Help You, logo beside the copy, four cards ·
 *        2b Client logo lanes (scroll-driven) · 3 Looping brand reel (with
 *        caption) · 4 The System, four pillar rows · 5 Selected case studies ·
 *        6 The reel, click to play · 7 Gallery · 8 Founder quote with both
 *        marks · 9 Feature image (with credit) · 10 Closing · 11 Next Step ·
 *        12 Footer
 *
 * The through-line is problem, help, trust, method, proof, person, ask.
 * Against the launch-day page: the second looping video and the empty Why It
 * Matters slot are gone, and blocks 2b, 5, 6, 7, 8 and 10 are new or filled.
 */
const path = '/';

const page = await getEntry('home', 'page');
const intro = await getEntry('home', 'intro');
if (!page || !intro) {
  throw new Error('content/home needs both page.md and intro.md');
}

const rows = await pillars();

// The founder quote and the closing statement, hoisted by type exactly as the
// Master template does it. The file holds no heading, so h2/statement stay null.
const anatomy = parseAnatomy(page.body ?? '');

/* Block 2: the section title is the file's single `#` heading, the paragraph
   under it is the visitor-facing statement, and each `##` is a card. Same flat
   split as index.astro, for the same reason: parseAnatomy would number the
   cards as rows. */
const introSource = (intro.body ?? '').trim();
const introTitle = introSource.match(/^#\s+(.+)$/m)?.[1]?.trim() ?? '';
const introCaption = introSource
  .replace(/^#\s+.+$/m, '')
  .split(/^##\s+/m)[0]!
  .replace(/\n/g, ' ')
  .trim();
const introBlocks = introSource
  .replace(/^#\s+.+$/m, '')
  .split(/^##\s+/m)
  .slice(1)
  .map((chunk) => {
    const [heading, ...rest] = chunk.trim().split(/\n{2,}/);
    return { title: heading!.trim(), body: rest.join(' ').replace(/\n/g, ' ').trim() };
  })
  .filter((block) => block.title && block.body);

const introLink =
  intro.data.linkLabel && intro.data.linkHref
    ? { label: intro.data.linkLabel, href: intro.data.linkHref }
    : null;

/* Block 5: three case studies. The frontmatter list wins; with no list the
   first three by `order` are used, so the block never renders empty while the
   collection holds anything. A slug that matches nothing throws, because a
   silently missing tile is the kind of bug that ships. */
const allStudies = (await getCollection('caseStudies')).sort(
  (a, b) => (a.data.order ?? Number.MAX_SAFE_INTEGER) - (b.data.order ?? Number.MAX_SAFE_INTEGER),
);
const wanted = page.data.caseStudies ?? [];
const picked = wanted.length
  ? wanted.map((slug) => {
      const found = allStudies.find((s) => s.id === slug);
      if (!found) throw new Error(`content/home/page.md lists case study "${slug}", which does not exist`);
      return found;
    })
  : allStudies.slice(0, 3);
const studies = picked.map((study) => ({
  href: `/work/case-studies/${study.id}`,
  name: study.data.client ?? study.data.title,
  blurb: study.data.caption ?? '',
  hero: assetsFor(study.id).hero,
}));

/* Block 7: the home gallery. Every image in `content/assets/home/gallery/`
   is a tile, in filename order, so swapping the set is a matter of replacing
   files. Same lightbox contract as the case studies: a 1800px-capped WebP for
   the viewer, the thumbnail through <Image>. The glob stays a literal string
   for Vite. */
const galleryModules = import.meta.glob<{ default: ImageMetadata }>(
  '../../content/assets/home/gallery/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const gallery = await Promise.all(
  Object.entries(galleryModules)
    .sort(([a], [b]) => a.localeCompare(b))
    .map(async ([, module], i) => {
      const full = await getImage({
        src: module.default,
        width: Math.min(1800, module.default.width),
        format: 'webp',
      });
      return { src: module.default, full: full.src, alt: `Alive ProStudios work, image ${i + 1}` };
    }),
);

/* Block 2b: the client logo lanes. Every PNG in `content/assets/logos-clients/`
   is a logo, in numeric filename order, dealt alternately into two lanes. The
   lanes glide sideways in opposite directions as the section crosses the
   viewport, driven by a scroll timeline rather than a clock: the wall moves
   when the visitor moves and rests when they rest. No autoplay, no marquee. */
const logoModules = import.meta.glob<{ default: ImageMetadata }>(
  '../../content/assets/logos-clients/*.{png,webp,svg}',
  { eager: true },
);
const logos = Object.entries(logoModules)
  .map(([path, module]) => ({ n: Number(path.match(/(\d+)\.\w+$/)?.[1] ?? 0), src: module.default }))
  .sort((a, b) => a.n - b.n)
  .map((l) => l.src);
const lanes = [logos.filter((_, i) => i % 2 === 0), logos.filter((_, i) => i % 2 === 1)].filter(
  (lane) => lane.length > 0,
);

const title = page.data.title;
const caption = page.data.caption ?? '';
const captionParts = caption ? splitSentences(caption) : [];
const systemDiagram = figure('/assets/diagrams/brand-to-revenue-system.svg');
---

<BaseLayout
  title={page.data.seoTitle ?? title}
  description={page.data.seoDescription}
  {path}
  breadcrumbs={[{ name: 'Home', url: '/' }]}
>
  <div class="page-root">
    <BgRails />

    <!-- 1. Hero: full-bleed photo, no overlay, credited -->
    <section class="hero" data-hero>
      <Image
        class="hero__bg"
        src={heroBg}
        alt=""
        widths={[768, 1280, 1920, 2400]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />

      <div class="hero__inner">
        <SiteNav active="/" />

        <div class="hero__copy">
          <h1 class="hero__title t-h1" data-hero-title>
            <span class="hero__line-mask">
              <span class="hero__line dot">{title}</span>
            </span>
          </h1>

          {
            captionParts.length > 0 && (
              <p class="hero__caption" data-hero-caption>
                <span class="hero__caption-lead">{captionParts[0]}</span>
                {captionParts.length > 1 && ` ${captionParts.slice(1).join(' ')}`}
              </p>
            )
          }
        </div>

        {page.data.heroCredit && <p class="hero__credit t-eyebrow">{page.data.heroCredit}</p>}
      </div>
    </section>

    <main id="main">
      <!-- 2. How We Help You: headline, statement, link, four cards -->
      {
        introBlocks.length > 0 && (
          <section class="intro section">
            {introTitle && <h2 class="intro__heading t-h2 dot z-content">{introTitle}</h2>}
            <div class="intro__lead z-content">
              {/* The full mark beside the statement. Two files, one per theme:
                  the coloured logo's dark green vanishes on the dark ground. */}
              <div class="intro__brand">
                <img class="intro__logo intro__logo--light" src="/assets/logo-full.svg" alt="Alive ProStudios" width="375" height="140" loading="lazy" />
                <img class="intro__logo intro__logo--dark" src="/assets/logo-full-white.svg" alt="" aria-hidden="true" width="375" height="140" loading="lazy" />
              </div>
              <div>
                {introCaption && <p class="intro__caption t-h4">{introCaption}</p>}
                {introLink && (
                  <a class="aps-btn aps-btn-primary intro__cta" href={introLink.href}>
                    <span class="roll">
                      <span>{introLink.label}</span>
                      <span>{introLink.label}</span>
                    </span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M7 17L17 7M9 7h8v8" />
                    </svg>
                  </a>
                )}
              </div>
            </div>
            <div class="intro__grid z-content">
              {introBlocks.map((block, i) => (
                <article class="intro__card">
                  <span class="intro__ghost" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="intro__num t-index">{String(i + 1).padStart(2, '0')}</span>
                  <h3 class="intro__title">{block.title}</h3>
                  <p class="intro__body">{block.body}</p>
                </article>
              ))}
            </div>
          </section>
        )
      }

      <!-- 2b. Client logo lanes: two rows gliding on scroll, opposite ways -->
      {
        lanes.length > 0 && (
          <section class="clients" aria-label={`Client logos, ${logos.length} brands`}>
            <div class="clients__head z-content">
              <p class="clients__eyebrow t-eyebrow">
                <span class="clients__num">(01)</span>&nbsp;&nbsp;Clients&nbsp;&nbsp;
                <span class="clients__count">({logos.length})</span>
              </p>
              {page.data.clientsHeading && (
                <h2 class="clients__heading t-h2 dot">{page.data.clientsHeading}</h2>
              )}
            </div>
            <div class="lanes z-content">
              {lanes.map((lane, l) => (
                <div class={`lane ${l % 2 ? 'lane--back' : 'lane--fore'}`}>
                  {lane.map((logo) => (
                    <div class="lane__card">
                      <Image src={logo} alt="" width={461} height={297} loading="lazy" decoding="async" />
                    </div>
                  ))}
                </div>
              ))}
            </div>
          </section>
        )
      }

      <!-- 3. Looping brand reel, captioned -->
      <VideoHero route="/" title="Alive ProStudios brand reel" />
      {page.data.reelCaption && <p class="loop__caption t-eyebrow z-content">{page.data.reelCaption}</p>}

      <!-- 4. The System: four pillar rows -->
      <section class="pillars">
        {/* Two deliberate lines, so "Performance System" never splits. The dot
            rides the second line, or it would drop to a line of its own. */}
        <h2 class="pillars__heading t-h2 z-content">
          <span class="pillars__line">The Brand-to-Revenue</span>
          <span class="pillars__line dot">Performance System</span>
        </h2>
        <p class="pillars__caption t-h4 z-content">
          Strategy, execution, and technology, engineered as one system. Built over 29 years,
          trusted by 400+ brands, retained for decades.
        </p>

        <figure class="pillars__figure">
          {
            systemDiagram.kind === 'svg' && (
              <img
                src={systemDiagram.src}
                alt="The Brand-to-Revenue Performance System: from Day One through Foundation, Execution, Growth and Infrastructure to market leadership, all built around your Brand Core."
                width={systemDiagram.width}
                height={systemDiagram.height}
                loading="lazy"
                decoding="async"
              />
            )
          }
        </figure>

        {
          rows.map((pillar) => (
            <div class="pillar z-content" data-stack>
              <span class="pillar__num">{pillar.num}</span>
              <div>
                <h3 class="pillar__name">
                  <a href={pillar.url} class="pillar__name-link">
                    {pillar.name}
                    <span class="pillar__dot" />
                  </a>
                </h3>
                <p class="pillar__kicker t-h5">{pillar.kicker}</p>
                <p class="pillar__body">{pillar.body}</p>
                <a href={pillar.url} class="aps-btn aps-btn-primary pillar__cta">
                  <span class="roll">
                    <span>Explore Now</span>
                    <span>Explore Now</span>
                  </span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M7 17L17 7M9 7h8v8" />
                  </svg>
                </a>
              </div>
            </div>
          ))
        }
      </section>

      <!-- 5. Selected case studies: the proof the live page lacks -->
      {
        studies.length > 0 && (
          <section class="proof section">
            <p class="proof__eyebrow t-eyebrow z-content">
              <span class="proof__num">(02)</span>&nbsp;&nbsp;Selected Case Studies&nbsp;&nbsp;
              <span class="proof__count">({allStudies.length})</span>
            </p>
            {page.data.proofHeading && (
              <h2 class="proof__heading t-h2 dot z-content">{page.data.proofHeading}</h2>
            )}
            <div class="proof__grid z-content">
              {studies.map((study, i) => (
                <a class="tile" href={study.href} data-stack>
                  <span class="tile__media">
                    {study.hero ? (
                      <Image
                        class="tile__img"
                        src={study.hero.src}
                        alt=""
                        widths={[480, 800, 1200]}
                        sizes="(max-width: 760px) 100vw, 33vw"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span class="tile__ghost" aria-hidden="true">
                        {String(i + 1).padStart(2, '0')}
                      </span>
                    )}
                  </span>
                  <span class="tile__num t-index">{String(i + 1).padStart(2, '0')}</span>
                  <h3 class="tile__title">
                    {study.name}
                    <span class="tile__dot" />
                  </h3>
                  {study.blurb && <p class="tile__blurb">{study.blurb}</p>}
                  <span class="tile__explore">
                    <span>Read Case Study</span>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M7 17L17 7M9 7h8v8" />
                    </svg>
                  </span>
                </a>
              ))}
            </div>
            <a class="proof__all z-content" href="/work/case-studies">
              <span>All case studies</span>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 17L17 7M9 7h8v8" />
              </svg>
            </a>
          </section>
        )
      }

      <!-- 6. The reel, click to play. Poster first, iframe on click, so the
           page does not mount a second YouTube player on load. -->
      {
        page.data.videoUrl && (
          <section class="reel section">
            <div class="reel__head z-content">
              {page.data.videoHeading && <h2 class="t-h2 dot">{page.data.videoHeading}</h2>}
              {page.data.videoCaption && <p class="reel__lede t-h4">{page.data.videoCaption}</p>}
            </div>
            <div class="reel__frame z-content">
              <InlineVideo url={page.data.videoUrl} />
            </div>
          </section>
        )
      }

      <!-- 7. Gallery: three across, folder-driven, opens the lightbox -->
      {
        gallery.length > 0 && (
          <section class="gallery" aria-label={`Work gallery, ${gallery.length} images`}>
            <p class="gallery__eyebrow t-eyebrow z-content">
              <span class="gallery__num">(03)</span>&nbsp;&nbsp;Gallery&nbsp;&nbsp;
              <span class="gallery__count">({gallery.length})</span>
            </p>
            <div class="gallery__grid z-content">
              {gallery.map((item, i) => (
                <button
                  type="button"
                  class="gallery__tile"
                  data-gallery-item
                  aria-label={`Open image ${i + 1} of ${gallery.length}`}
                >
                  <Image
                    src={item.src}
                    alt={item.alt}
                    widths={[480, 800, 1200]}
                    sizes="(max-width: 760px) 50vw, 33vw"
                    loading="lazy"
                    decoding="async"
                  />
                </button>
              ))}
            </div>
            <script
              id="gallery-data"
              type="application/json"
              is:inline
              set:html={JSON.stringify(gallery.map((g) => ({ full: g.full, alt: g.alt })))}
            />
            <Lightbox />
          </section>
        )
      }

      <!-- 8. Founder quote band, with both marks -->
      {
        anatomy.quote && (
          <section class="quote">
            <div class="quote__inner z-content" data-stack>
              <Image
                class="quote__portrait"
                src={founderPortrait}
                alt="Javad Ahmadi, Founder and Brand Transformation Architect"
                widths={[320, 640]}
                sizes="(max-width: 760px) 240px, 320px"
                loading="lazy"
              />
              <div>
                <blockquote class="t-h4 quote__text" set:html={anatomy.quote.html} />
                {anatomy.quote.name && (
                  <p class="quote__by">
                    {anatomy.quote.name}
                    {anatomy.quote.role && <span class="quote__role">{anatomy.quote.role}</span>}
                  </p>
                )}
                <div class="quote__marks">
                  <img class="quote__mark quote__mark--light" src="/assets/logo-full.svg" alt="Alive ProStudios" width="375" height="140" loading="lazy" />
                  <img class="quote__mark quote__mark--dark" src="/assets/logo-full-white.svg" alt="" aria-hidden="true" width="375" height="140" loading="lazy" />
                  <a class="quote__javad" href="https://javad.ca/" target="_blank" rel="noopener" aria-label="Javad Ahmadi, javad.ca (opens in a new window)">
                    <img class="quote__mark quote__mark--light" src="/assets/javad-ahmadi-logo.svg" alt="" width="522" height="112" loading="lazy" />
                    <img class="quote__mark quote__mark--dark" src="/assets/javad-ahmadi-logo-white.svg" alt="" aria-hidden="true" width="522" height="112" loading="lazy" />
                  </a>
                </div>
              </div>
            </div>
          </section>
        )
      }

      <!-- 9. Feature image, parallax. The DNA image that opened the page until
           2026-09-02, moved here at Javad's direction; no credit, it is not client work. -->
      <section class="feature" data-feature>
        <Image
          class="feature__img"
          src={homeFeature}
          alt="Green DNA double helices beaded with water droplets, lit with amber highlights against a dark background"
          widths={[768, 1280, 1920, 2400]}
          sizes="100vw"
          loading="lazy"
          decoding="async"
        />
        {
          page.data.featureCredit &&
            (page.data.featureCreditHref ? (
              <a class="feature__credit t-eyebrow" href={page.data.featureCreditHref}>
                {page.data.featureCredit}
              </a>
            ) : (
              <p class="feature__credit t-eyebrow">{page.data.featureCredit}</p>
            ))
        }
      </section>

      <!-- 10. Closing statement -->
      {
        anatomy.closing && (
          <section class="section">
            <p class="closing t-h4 z-content">
              <Fragment set:html={anatomy.closing.lead} />{' '}
              <span class="muted" set:html={anatomy.closing.muted} />
              {anatomy.closing.tail && (
                <>
                  {' '}
                  <Fragment set:html={anatomy.closing.tail} />
                </>
              )}
            </p>
          </section>
        )
      }
    </main>

    <!-- 11. Next Step -->
    <NextStep sectionNum="04" />

    <!-- 12. Footer -->
    <SiteFooter backLabel="Alive ProStudios" backHref="/" nextLabel="All Services" nextHref="/foundation" />
  </div>
</BaseLayout>

<style>
  /* Styles are index.astro's, minus the Why It Matters slot, plus the credit
     lines, the intro link, the reel caption and the case study tiles. When
     Home-B replaces the live page these move with it. */

  /* ---- 1. Hero ---------------------------------------------------------- */
  .hero {
    position: relative;
    background: var(--surface-hero-bottom);
    color: #fff;
    min-height: 85vh;
    display: flex;
    flex-direction: column;
    padding-bottom: 88px;
    overflow: hidden;
  }
  .hero__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero__inner { position: relative; z-index: var(--z-nav); flex: 1; display: flex; flex-direction: column; }
  .hero__copy { flex: 1; display: flex; flex-direction: column; justify-content: center; padding: 56px var(--gutter) 0; }
  .hero__title {
    margin: 0;
    line-height: 0.92;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.35), 0 16px 48px rgba(0, 0, 0, 0.45);
  }
  .hero__line-mask { display: block; overflow: hidden; }
  .hero__line { display: block; animation: heroRise var(--dur-hero) var(--ease-settle) both 150ms; }
  .hero__caption {
    max-width: 1200px;
    margin: 32px 0 0;
    font-weight: 600;
    /* Javad asked for a bigger subtitle, 2026-09-02: from 45px to 64px at the
       top of the range, about 45% of the H1's 144px. */
    font-size: clamp(28px, 4.6vw, 64px);
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--brand-orange);
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.4), 0 10px 32px rgba(0, 0, 0, 0.4);
    animation: heroFade 800ms var(--ease-settle) both 600ms;
  }
  .hero__caption-lead { color: #fff; }

  /* The credit sits in the hero's bottom padding, right-aligned to the gutter,
     so it reads as a caption on the photograph rather than part of the copy. */
  .hero__credit {
    position: absolute;
    right: var(--gutter);
    bottom: -56px;
    margin: 0;
    color: rgba(255, 255, 255, 0.72);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
    animation: heroFade 800ms var(--ease-settle) both 900ms;
  }

  /* ---- 2. How We Help You ---------------------------------------------- */
  .intro__heading { margin: 0 0 40px; }

  /* The mark takes the label column, the statement the rest. */
  .intro__lead {
    display: grid;
    grid-template-columns: minmax(220px, 1fr) 2fr;
    gap: clamp(32px, 5vw, 96px);
    align-items: center;
    margin-bottom: 64px;
  }
  .intro__brand { display: flex; align-items: center; }
  .intro__logo { display: block; width: 100%; max-width: 360px; height: auto; }
  .intro__logo--dark { display: none; }
  :global(body[data-theme='dark']) .intro__logo--light { display: none; }
  :global(body[data-theme='dark']) .intro__logo--dark { display: block; }

  .intro__caption { max-width: 680px; margin: 0 0 32px; color: var(--pg-fg2); }

  /* The same orange pill as the pillar rows' Explore Now, so the page's two
     calls to action look like one device. Base.css owns the button itself. */
  .intro__cta { margin: 0; }

  .intro__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .intro__card {
    position: relative;
    background: var(--pg-band);
    padding: 44px 40px 48px;
    overflow: hidden;
    transform: translateY(0);
    transition: transform var(--dur-move) var(--ease-settle);
  }
  .intro__card:hover { transform: translateY(-6px); }
  .intro__card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    height: 2px;
    width: 64px;
    background: var(--brand-orange);
    transition: width 480ms var(--ease-settle);
  }
  .intro__card:hover::before { width: 100%; }
  .intro__ghost {
    position: absolute;
    top: -28px;
    right: 12px;
    font-family: var(--font-condensed);
    font-weight: 800;
    font-size: 176px;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--pg-line);
    pointer-events: none;
