---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
/* Moved out of public/ so the build can process them: raw files there are
   shipped byte-for-byte with no WebP/AVIF and no srcset, which STYLEGUIDE §8
   requires. hero-bg is the home page's LCP element, so it was the single
   heaviest thing on the site's most important page. */
import heroBg from '../../content/assets/site/hero-bg.jpg';
import homeFeature from '../../content/assets/site/home-feature.jpg';
import founderPortrait from '../../content/assets/site/javad-ahmadi-portrait.jpg';
import BgRails from '../components/BgRails.astro';
import SiteNav from '../components/SiteNav.astro';
import VideoHero from '../components/VideoHero.astro';
import NextStep from '../components/NextStep.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { pillars } from '../lib/pillars';
import { parseAnatomy, splitSentences } from '../lib/anatomy';
import { figure } from '../lib/figures';
import homepageMarkdown from '../../content/homepage.md?raw';
import homeIntroMarkdown from '../../content/home-intro.md?raw';

/**
 * Home Page Template (STYLEGUIDE.md §9).
 *
 * Differs from Master in three ways: a full-bleed PHOTO hero instead of the
 * grey gradient, pillar rows instead of content rows, and NO BookConsult and
 * NO Related Services.
 *
 * Order: 1 Hero · 2 Why It Matters · 3 VideoHero · 4 Pillars · 4b Second video
 *        5 Founder quote · 6 Feature image · 7 Closing · 8 NextStep · 9 Footer
 *
 * Note slot 3: the video sits AFTER Why It Matters here, unlike Master.
 *
 * Slot 4b is a second looping video, pinned to one Vimeo id via VideoHero's
 * `videoId` prop rather than drawn from `content/work/hero-videos.md`'s Home
 * pool. It sits between the pillar rows and the founder quote band, so it
 * reads as "above the feature image" while slot 5 stays empty (see below).
 *
 * Slots 2, 5 and 7 read from `content/homepage.md`, which currently holds Sanity
 * block descriptors rather than prose. They render nothing until that file
 * carries copy. Omitted, never invented (§9 Clarifications).
 */
const rows = await pillars();

// homepage.md sits outside the collections because its current format is Sanity
// block descriptors rather than prose, so it is read raw and run through the
// same anatomy parser as every other page. Slots 2, 5 and 7 stay empty until it
// holds real copy; the moment it does, they populate with no code change.
const homeBody = homepageMarkdown.replace(/^---\n[\s\S]*?\n---\n/, '');

// homepage.md is still in Sanity block-descriptor format: `## [blockKineticHero]`,
// `## [blockStats]`, and so on. Those headings are structural markers, not copy,
// so the file carries no prose at all and must not be parsed as if it did.
const isBlockDescriptorFormat = /^##\s*\[block\w+\]/m.test(homeBody);
const anatomy = parseAnatomy(isBlockDescriptorFormat ? '' : homeBody);

/**
 * Slot 1b: the four intro blocks, from `content/home-intro.md`.
 *
 * Read raw and split here rather than run through `parseAnatomy`, because that
 * parser maps a document onto the Master template's slots: it would hoist the
 * first heading into an H2, number the rest as rows, and promote the final
 * paragraph to a closing statement. This module is four peers, so it wants a
 * flat `## heading` + paragraph split and nothing else.
 *
 * Same `?raw` route as homepage.md above: the copy stays in Markdown, editable
 * without touching this file, but the module is not a routed page so it does not
 * belong in a content collection either.
 */
const introSource = homeIntroMarkdown.replace(/^---\n[\s\S]*?\n---\n/, '');

/** The module's own section title: the file's single `#` heading. */
const introTitle = introSource.match(/^#\s+(.+)$/m)?.[1]?.trim() ?? '';

/** The paragraph between the `#` heading and the first `##` card. */
const introCaptionSource = introSource.replace(/^#\s+.+$/m, '').split(/^##\s+/m)[0]!.trim();
const introCaption = introCaptionSource.replace(/\n/g, ' ').trim();

const introBlocks = introSource
  .replace(/^#\s+.+$/m, '')
  .split(/^##\s+/m)
  .slice(1)
  .map((chunk) => {
    const [heading, ...rest] = chunk.trim().split(/\n{2,}/);
    return { title: heading!.trim(), body: rest.join(' ').replace(/\n/g, ' ').trim() };
  })
  .filter((block) => block.title && block.body);

const title = 'Fragmented Marketing is Expensive.';
const description =
  'Alive ProStudios is a Toronto brand transformation studio. Strategy, identity, ' +
  'creative production, growth marketing, and the systems behind them. Est. 1997.';

// The hero caption. `.hero__caption` already uppercases it, so it is authored
// in sentence case and rendered in caps.
const caption = 'Brand transformation is not.';
const captionParts = caption ? splitSentences(caption) : [];

// The system diagram, shared with why-alive-pro.md's "Four Pillars" section.
const systemDiagram = figure('/assets/diagrams/brand-to-revenue-system.svg');
---

<BaseLayout {title} {description} path="/" breadcrumbs={[{ name: 'Home', url: '/' }]}>
  <div class="page-root">
    <BgRails />

    <!-- 1. Hero: full-bleed photo, no overlay -->
    <section class="hero" data-hero>
      <Image
        class="hero__bg"
        src={heroBg}
        alt=""
        widths={[768, 1280, 1920, 2400]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />

      <div class="hero__inner">
        <SiteNav active="/" />

        <div class="hero__copy">
          <h1 class="hero__title t-h1" data-hero-title>
            <span class="hero__line-mask">
              <span class="hero__line dot">{title}</span>
            </span>
          </h1>

          {
            captionParts.length > 0 && (
              <p class="hero__caption" data-hero-caption>
                <span class="hero__caption-lead">{captionParts[0]}</span>
                {captionParts.length > 1 && ` ${captionParts.slice(1).join(' ')}`}
              </p>
            )
          }
        </div>
      </div>
    </section>

    <main id="main">
      <!-- 1b. Intro: section title + four cards -->
      {
        introBlocks.length > 0 && (
          <section class="intro section">
            {introTitle && <h2 class="intro__heading t-h2 dot z-content">{introTitle}</h2>}
            {introCaption && <p class="intro__caption t-h4 z-content">{introCaption}</p>}
            <div class="intro__grid z-content">
              {introBlocks.map((block, i) => (
                <article class="intro__card">
                  <span class="intro__ghost" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="intro__num t-index">{String(i + 1).padStart(2, '0')}</span>
                  <h3 class="intro__title">{block.title}</h3>
                  <p class="intro__body">{block.body}</p>
                </article>
              ))}
            </div>
          </section>
        )
      }

      <!-- 2. Why It Matters -->
      {
        anatomy.h2 && (
          <section class="why section" data-stack>
            <p class="why__label t-eyebrow z-content">
              <span class="why__num">(01)</span>&nbsp;&nbsp;Why It Matters
            </p>
            <div class="z-content">
              <h2 class="t-h2">{anatomy.h2}</h2>
              {anatomy.statement && (
                <p class="why__statement t-h4">
                  <Fragment set:html={anatomy.statement.lead} />{' '}
                  <span class="muted" set:html={anatomy.statement.muted} />
                </p>
              )}
              {anatomy.stat && (
                <div class="stat">
                  <div class="stat__figure">{anatomy.stat.figure}</div>
                  <p class="stat__caption">
                    <Fragment set:html={anatomy.stat.caption.lead} />{' '}
                    <span class="stat__strong" set:html={anatomy.stat.caption.muted} />
                  </p>
                </div>
              )}
            </div>
          </section>
        )
      }

      <!-- 3. VideoHero -->
      <VideoHero route="/" title="Alive ProStudios brand reel" />

      <!-- 4. Four pillar rows -->
      <section class="pillars">
        <h2 class="pillars__heading t-h2 dot z-content">The Brand-to-Revenue Performance System</h2>
        <p class="pillars__caption t-h4 z-content">
          Strategy, execution, and technology, engineered as one system. Built over 29 years,
          trusted by 400+ brands, retained for decades.
        </p>

        <figure class="pillars__figure">
          {
            systemDiagram.kind === 'svg' && (
              <img
                src={systemDiagram.src}
                alt="The Brand-to-Revenue Performance System: from Day One through Foundation, Execution, Growth and Infrastructure to market leadership, all built around your Brand Core."
                width={systemDiagram.width}
                height={systemDiagram.height}
                loading="lazy"
                decoding="async"
              />
            )
          }
        </figure>

        {
          rows.map((pillar) => (
            <div class="pillar z-content" data-stack>
              <span class="pillar__num">{pillar.num}</span>
              <div>
                {/* H3 under the section's H2 heading. Visual spec unchanged:
                    the size comes from .pillar__name, not the tag. */}
                <h3 class="pillar__name">
                  <a href={pillar.url} class="pillar__name-link">
                    {pillar.name}
                    <span class="pillar__dot" />
                  </a>
                </h3>
                <p class="pillar__kicker t-h5">{pillar.kicker}</p>
                <p class="pillar__body">{pillar.body}</p>
                <a href={pillar.url} class="aps-btn aps-btn-primary pillar__cta">
                  <span class="roll">
                    <span>Explore Now</span>
                    <span>Explore Now</span>
                  </span>
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M7 17L17 7M9 7h8v8" />
                  </svg>
                </a>
              </div>
            </div>
          ))
        }
      </section>

      <!-- 4b. Second looping video, pinned regardless of route -->
      <VideoHero
        route="/"
        videoId="https://vimeo.com/1211175802"
        title="Alive ProStudios video"
      />

      <!-- 5. Founder quote band -->
      {
        anatomy.quote && (
          <section class="quote">
            <div class="quote__inner z-content" data-stack>
              <Image
                class="quote__portrait"
                src={founderPortrait}
                alt="Javad Ahmadi, Founder and Brand Transformation Architect"
                widths={[320, 640]}
                sizes="(max-width: 760px) 240px, 320px"
                loading="lazy"
              />
              <div>
                <blockquote class="t-h4 quote__text" set:html={anatomy.quote.html} />
                {anatomy.quote.name && (
                  <p class="quote__by">
                    {anatomy.quote.name}
                    {anatomy.quote.role && <span class="quote__role">{anatomy.quote.role}</span>}
                  </p>
                )}
              </div>
            </div>
          </section>
        )
      }

      <!-- 6. Feature image, parallax -->
      <section class="feature" data-feature>
        <Image
          class="feature__img"
          src={homeFeature}
          alt="Alfred smart home touchscreen deadbolt retail packaging in satin nickel, three boxes showing the bilingual carton system"
          widths={[768, 1200, 1500]}
          sizes="100vw"
          loading="lazy"
          decoding="async"
        />
      </section>

      <!-- 7. Closing statement -->
      {
        anatomy.closing && (
          <section class="section">
            <p class="closing t-h4 z-content">
              <Fragment set:html={anatomy.closing.lead} />{' '}
              <span class="muted" set:html={anatomy.closing.muted} />
            </p>
          </section>
        )
      }
    </main>

    <!-- 8. Next Step -->
    <NextStep sectionNum="03" />

    <!-- 9. Footer -->
    <SiteFooter backLabel="Alive ProStudios" backHref="/" nextLabel="All Services" nextHref="/foundation" />
  </div>
</BaseLayout>

<style>
  /* ---- 1. Hero: full-bleed PHOTO, no overlay -------------------------- */
  .hero {
    position: relative;
    background: var(--surface-hero-bottom);
    color: #fff;
    min-height: 85vh;
    display: flex;
    flex-direction: column;
    padding-bottom: 88px;
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__inner {
    position: relative;
    z-index: var(--z-nav);
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .hero__copy {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 56px var(--gutter) 0;
  }

  .hero__title {
    margin: 0;
    line-height: 0.92;
    /* Lifts the white type off the photo: a tight contact shadow for edge
       definition plus a wide soft one for separation. text-shadow inherits, so
       both hero lines pick it up. */
    text-shadow:
      0 2px 6px rgba(0, 0, 0, 0.35),
      0 16px 48px rgba(0, 0, 0, 0.45);
  }
  .hero__line-mask { display: block; overflow: hidden; }
  .hero__line { display: block; animation: heroRise var(--dur-hero) var(--ease-settle) both 150ms; }

  .hero__caption {
    max-width: 900px;
    margin: 32px 0 0;
    font-weight: 600;
    /* 45px at desktop, scaling down through the fluid band. */
    font-size: clamp(24px, 3.5vw, 45px);
    line-height: 1.3;
    text-transform: uppercase;
    color: var(--brand-orange);
    text-shadow:
      0 2px 6px rgba(0, 0, 0, 0.4),
      0 10px 32px rgba(0, 0, 0, 0.4);
    animation: heroFade 800ms var(--ease-settle) both 600ms;
  }
  .hero__caption-lead { color: #fff; }

  /* ---- 1b. Intro: "29 Years in the Making" -----------------------------
     Four cards on the band surface, each carrying three devices the system
     already owns: the mono index, a 2px orange rule that draws itself across
     the top on hover, and an outlined ghost numeral in the corner set in the
     display face. Titles are Condensed 800 at the H3 scale. The cards fade in
     on scroll via view() timelines, opacity only, so the hover lift's
     transform never fights the reveal. */
  .intro__heading { margin: 0 0 24px; }

  .intro__caption {
    max-width: 680px;
    margin: 0 0 56px;
    color: var(--pg-fg2);
  }

  .intro__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .intro__card {
    position: relative;
    background: var(--pg-band);
    padding: 44px 40px 48px;
    overflow: hidden;
    transform: translateY(0);
    transition: transform var(--dur-move) var(--ease-settle);
  }
  .intro__card:hover { transform: translateY(-6px); }

  /* The rule starts as a short tab and draws across the card on hover. */
  .intro__card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    height: 2px;
    width: 64px;
    background: var(--brand-orange);
    transition: width 480ms var(--ease-settle);
  }
  .intro__card:hover::before { width: 100%; }

  .intro__ghost {
    position: absolute;
    top: -28px;
    right: 12px;
    font-family: var(--font-condensed);
    font-weight: 800;
    font-size: 176px;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--pg-line);
    pointer-events: none;
    user-select: none;
  }

  .intro__num { display: block; margin-bottom: 18px; color: var(--orange-ink); }

  .intro__title {
    font-family: var(--font-condensed);
    font-weight: 800;
    font-size: clamp(26px, 2.6vw, 40px);
    line-height: 1.04;
    text-transform: uppercase;
    color: var(--pg-fg);
    margin: 0 0 18px;
  }

  .intro__body {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--pg-fg2);
    max-width: 46ch;
  }

  /* Scroll reveal: each card fades in as it enters the viewport. Opacity only,
     see the note above. Browsers without view() just show the cards; reduced
     motion is killed globally in base.css. */
  @supports (animation-timeline: view()) {
    .intro__card {
      animation: introReveal linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 70%;
    }
  }
  @keyframes introReveal {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* ---- 2. Why It Matters ---------------------------------------------- */
  .why {
    display: grid;
    grid-template-columns: var(--col-label) 1fr;
    gap: 40px;
    align-items: start;
  }
  .why__label { color: var(--pg-fg); margin: 0; }
  .why__num { color: var(--orange-ink); }
  .why__statement { max-width: 680px; margin: 56px 0 0; }

  .stat {
    border-top: 2px solid var(--brand-orange);
    padding-top: 24px;
    margin-top: 64px;
    max-width: 680px;
  }
  .stat__figure {
    font-family: var(--font-condensed);
    font-weight: 800;
    font-size: clamp(64px, 6vw, 112px);
    line-height: 1;
    color: var(--orange-ink);
  }
  .stat__caption {
    margin: 16px 0 0;
    font-weight: 600;
    font-size: 15px;
    line-height: 1.5;
    text-transform: uppercase;
    color: var(--pg-fg3);
  }
  .stat__strong { color: var(--pg-fg); }

  /* ---- 4. Pillar rows -------------------------------------------------- */
  .pillars { padding: 0 var(--gutter) 64px; }
  .pillars__heading { margin: 112px 0 24px; }

  .pillars__caption {
    max-width: 680px;
    margin: 0 0 56px;
    color: var(--pg-fg2);
  }

  /* Full screen, edge to edge. `.pillars` is padded by exactly one gutter each
     side, so pulling the figure back by that much lands it on the viewport
     edges, same trick as MasterPage's `.rows__figure`. Transparent in both
     themes: the SVG's own artwork paints a large opaque white capsule that
     covers most of this box regardless, so this only ever affects the small
     margins outside that capsule (the corners near DAY ONE / MARKET
     LEADERSHIP). Matching the page background there, instead of forcing
     white, keeps those margins blended into the page rather than fighting it. */
  .pillars__figure {
    position: relative;
    z-index: var(--z-content);
    margin: 0 calc(var(--gutter) * -1) 64px;
    background: var(--pg-bg);
  }
  .pillars__figure img { display: block; width: 100%; height: auto; }

  .pillar {
    display: grid;
    grid-template-columns: var(--col-num) 1fr;
    gap: clamp(24px, 3vw, 56px);
    border-top: 1px solid var(--pg-line);
    padding: 56px 0;
    align-items: start;
    color: var(--pg-fg);
    transform: translateX(0);
    transition: transform var(--dur-move) var(--ease-settle);
  }
  .pillar:hover { transform: translateX(12px); }

  .pillar__num {
    font-family: var(--font-condensed);
    font-weight: 800;
    font-size: 56px;
    line-height: 1;
    color: var(--orange-ink);
  }

  .pillar__name { font-size: 0; margin: 0 0 14px; }

  /* The heading's own visual spec lives on the link, since that's the actual
     text node now: the H3 wraps it for outline order, not for styling. */
  .pillar__name-link {
    display: inline-block;
    font-family: var(--font-condensed);
    font-weight: 800;
    font-size: clamp(40px, 4.4vw, 72px);
    line-height: 0.96;
    text-transform: uppercase;
    color: var(--pg-fg);
    text-decoration: none;
    transition: color var(--dur-micro) ease;
  }
  .pillar:hover .pillar__name-link,
  .pillar__name-link:hover { color: var(--orange-ink); }

  .pillar__dot {
    display: inline-block;
    width: 0.14em;
    height: 0.14em;
    margin-left: 0.06em;
    background: var(--brand-orange);
    border-radius: 999px;
  }

  .pillar__kicker { margin: 0 0 20px; color: var(--orange-ink); }

  .pillar__body {
    margin: 0 0 32px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--pg-fg2);
    max-width: 720px;
  }

  .pillar__cta { position: relative; z-index: 1; }

  /* ---- 5. Founder quote band ------------------------------------------ */
  .quote { background: var(--pg-band); padding: 96px var(--gutter); }
  .quote__inner {
    max-width: 1160px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: clamp(32px, 4vw, 64px);
    align-items: start;
  }
  .quote__portrait {
    width: 100%;
    max-width: 320px;
    height: auto;
    border-radius: 12px;
  }
  .quote__text { margin: 0; }
  .quote__by { margin: 32px 0 0; font-weight: 700; font-size: 15px; color: var(--pg-fg); }
  .quote__role {
    margin-left: 12px;
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pg-fg3);
  }

  /* ---- 6. Feature image, parallax --------------------------------------
     Height reduced 40% from the original 100vh. Two independent knobs:

       height (140%)                  the SLIDE budget. The element is taller
                                      than the frame, and the surplus is the
                                      only thing the image has room to travel
                                      through. This is where the movement comes
                                      from; do not trade it away.
       --pf-zoom-from / --pf-zoom-to  the PUSH, a slow scale across the scroll.

     Do not try to fund the slide out of the zoom instead. Scale spreads its
     surplus over all four sides, so a 1.08 zoom buys only 4% of the frame's
     height to move through, against the 20% that height:140% gives outright.
     Built that way the effect measures ~32px of travel and reads as nothing
     at all on screen.

     `top:50%` plus a base `translateY(-50%)` centres the surplus, so the slide
     is just that -50% plus or minus `--pf-shift`, in % of the ELEMENT's height.
     Staying covered needs `height x zoom / 2 >= 50% + height x shift`, which at
     140% and the values below holds with roughly 30px to spare at the tight
     end. Widen `--pf-shift` past ~18% and the image lifts off an edge, which
     the frame cannot hide.

     Un-animated it sits centred at the start zoom, which is also what
     `prefers-reduced-motion` leaves behind, since base.css kills every
     animation globally. */
  /* `overflow: hidden` makes this frame a scroll container, and a bare
     `view()` on the image would then resolve ITS scrollport to this frame
     rather than the page. The frame never scrolls, so that timeline is
     degenerate and parks at 50% for good: the image sits frozen mid-effect and
     nothing moves. Naming the timeline here, on the element whose travel
     through the viewport we actually mean, is what makes it track the page.
     Keep the name and the frame together if this rule is ever split up. */
  .feature {
    position: relative;
    height: 60vh;
    overflow: hidden;
    view-timeline-name: --featureView;
    view-timeline-axis: block;
  }

  .feature__img {
    --pf-zoom-from: 1.02;
    --pf-zoom-to: 1.14;
    --pf-shift: 10%;

    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: 140%;
    object-fit: cover;
    /* Below centre. The frame is ~2.7:1 on a laptop against a 16:9 source, so
       `cover` is always dropping a third of the image height; biasing down
       keeps the front carton's branding whole and spends the loss on the top
       face of the tall box instead. */
    object-position: center 45%;
    transform: translateY(-50%) scale(var(--pf-zoom-from));
  }

  /* Scroll-driven, so no scroll listener and no JS. Browsers without
     `animation-timeline` simply keep the still crop above. */
  @supports (animation-timeline: view()) {
    .feature__img {
      animation-name: featureParallax;
      animation-duration: auto;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: --featureView;
      animation-range: cover 0% cover 100%;
      will-change: transform;
    }
  }

  /* Two moves at once. The image lags the page, sliding down inside the frame
     as the frame travels up the viewport, and it pushes in the whole way, so
     the crop tightens as the section passes. Depth from the lag, life from the
     push. Reverse either and it races the scroll instead. */
  @keyframes featureParallax {
    from {
      transform: translateY(calc(-50% - var(--pf-shift))) scale(var(--pf-zoom-from));
    }
