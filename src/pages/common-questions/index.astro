---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BgRails from '../../components/BgRails.astro';
import SiteNav from '../../components/SiteNav.astro';
import VideoHero from '../../components/VideoHero.astro';
import BookConsult from '../../components/BookConsult.astro';
import NextStep from '../../components/NextStep.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { questionCount, clusters } from '../../lib/commonQuestions';

/**
 * /common-questions — the hub.
 *
 * One row per topic, nothing else. Javad's direction, 2026-09-02: the three
 * category buckets looked like a structure that could not grow, so the hub
 * lists topics only and the questions live on the topic pages. A topic is one
 * Markdown file; adding one adds its row, its menu entry and every count here
 * with no code change.
 */
const path = '/common-questions';
const title = 'Common Questions';
const description =
  'Straight answers on branding, marketing, search and business systems, for ' +
  'business owners deciding what to do next. Some of them end with advice not ' +
  'to spend the money.';

const count = await questionCount();
const all = await clusters();
const SITE = 'https://aliveprostudios.com';

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${SITE}${path}#collection`,
    name: 'Alive ProStudios Common Questions',
    description,
    publisher: { '@id': `${SITE}/#organization` },
    hasPart: all.map((c) => ({
      '@type': 'WebPage',
      '@id': `${SITE}${c.url}#page`,
      name: c.seoTitle,
      url: `${SITE}${c.url}`,
    })),
  },
];

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: title, url: path },
];
---

<BaseLayout {title} {description} {path} {schema} {breadcrumbs}>
  <div class="page-root">
    <BgRails />

    <section class="hero">
      <div class="hero__inner">
        <SiteNav active={path} />
        <div class="hero__copy">
          <p class="hero__crumb t-eyebrow">Alive ProStudios&nbsp;&nbsp;·&nbsp;&nbsp;Common Questions</p>
          <h1 class="hero__title t-h1">
            <span class="hero__line-mask"><span class="hero__line dot">Common questions</span></span>
          </h1>
          <p class="hero__caption">
            <span class="hero__caption-lead">{count} answers, no sales pitch.</span>{' '}
            <span class="hero__caption-tail">Several of them end with advice not to spend the money.</span>
          </p>
        </div>
      </div>
    </section>

    <VideoHero route={path} title="Alive ProStudios reel" />

    <main id="main">
      <section class="cqh section">
        <p class="cqh__eyebrow t-eyebrow z-content">
          <span class="cqh__num">(01)</span>&nbsp;&nbsp;Topics&nbsp;&nbsp;
          <span class="cqh__count">({count})</span>
        </p>
        <h2 class="cqh__heading t-h2 dot z-content">Topics</h2>

        {/* One row per topic, the list the section grows by. A topic is one
            Markdown file; this list, the menu row and every count follow it. */}
        <ol class="cqh__topics z-content">
          {all.map((topic, i) => (
            <li class="cqh__topic">
              <a class="cqh__topicLink" href={topic.url}>
                <span class="cqh__topicIndex t-index">{String(i + 1).padStart(2, '0')}</span>
                <span class="cqh__topicBody">
                  <span class="cqh__topicTitle">{topic.title}</span>
                  <span class="cqh__topicCaption">{topic.caption}</span>
                </span>
                <span class="cqh__topicMeta">
                  {topic.questions.length} {topic.questions.length === 1 ? 'answer' : 'answers'}
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>

      <section class="cqh section cqh--ask">
        <p class="cqh__eyebrow t-eyebrow z-content">
          <span class="cqh__num">(02)</span>&nbsp;&nbsp;Not here
        </p>
        <h2 class="cqh__heading t-h2 dot z-content">Ask us the one that is missing</h2>
        <p class="cqh__ask z-content">
          This section grows from the questions people actually ask in first conversations.
          If yours is not answered here, send it to us and we will answer it directly,
          whether or not it turns into work.
        </p>
        <a class="cqh__askLink z-content" href="/contact">Ask a question</a>
      </section>

      <BookConsult />
    </main>

    <NextStep sectionNum="03" />
    <SiteFooter backLabel="Case Studies" backHref="/work/case-studies" nextLabel="Alive Pro" nextHref="/alive-pro" />
  </div>
</BaseLayout>

<style>
  .hero {
    position: relative;
    background: linear-gradient(180deg, var(--surface-hero-top) 0%, var(--surface-hero-bottom) 100%);
    color: #fff;
    padding-bottom: 88px;
    overflow: hidden;
  }
  .hero__inner { position: relative; z-index: var(--z-nav); }
  .hero__copy { padding: 56px var(--gutter) 0; }
  .hero__crumb {
    color: var(--brand-lime);
    margin: 0 0 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--brand-orange);
    width: fit-content;
    animation: heroFade 800ms var(--ease-settle) both 100ms;
  }
  .hero__title { margin: 0; }
  .hero__line-mask { display: block; overflow: hidden; }
  .hero__line { display: block; animation: heroRise var(--dur-hero) var(--ease-settle) both 150ms; }
  .hero__caption {
    margin: 32px 0 0;
    max-width: 720px;
    font-size: clamp(15px, 1.3vw, 17px);
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1.6;
    text-transform: uppercase;
    animation: heroFade 800ms var(--ease-settle) both 300ms;
  }
  .hero__caption-lead { color: #fff; }
  .hero__caption-tail { color: var(--brand-orange); }

  .cqh { padding-top: 0; }
  .cqh:first-of-type { padding-top: 96px; }
  .cqh__eyebrow { color: var(--pg-fg); margin: 0 0 28px; }
  .cqh__num { color: var(--orange-ink); }
  .cqh__count { color: var(--pg-fg3); }
  .cqh__heading { margin: 0 0 48px; }

  .cqh__topics { margin: 0; padding: 0; list-style: none; }
  .cqh__topic { border-top: 1px solid var(--pg-line); }
  .cqh__topic:last-child { border-bottom: 1px solid var(--pg-line); }
  .cqh__topicLink {
    display: grid;
    grid-template-columns: var(--col-num) 1fr auto;
    gap: clamp(24px, 3vw, 56px);
    align-items: baseline;
    padding: 26px 0;
    text-decoration: none;
    color: var(--pg-fg);
    transition: color var(--dur-micro) ease, transform var(--dur-micro) var(--ease-settle);
  }
  .cqh__topicLink:hover { color: var(--orange-ink); transform: translateX(6px); }
  .cqh__topicLink:focus-visible { outline: 2px solid var(--brand-orange); outline-offset: 4px; }
  .cqh__topicIndex { padding-top: 0.35em; }
  .cqh__topicBody { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .cqh__topicTitle {
    font-weight: 600;
    font-size: clamp(19px, 1.7vw, 24px);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .cqh__topicCaption { max-width: 62ch; font-size: 15px; line-height: 1.5; color: var(--pg-fg2); }
  .cqh__topicMeta {
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--pg-fg3);
  }

  .cqh--ask { padding-top: 24px; }
  .cqh__ask {
    margin: 0 0 32px;
    max-width: 60ch;
    font-size: clamp(17px, 1.45vw, 19px);
    line-height: 1.65;
    color: var(--pg-fg2);
  }
  .cqh__askLink {
    display: inline-block;
    padding: 15px 30px;
    background: var(--brand-orange);
    color: #fff;
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: transform var(--dur-micro) var(--ease-settle);
  }
  .cqh__askLink:hover { transform: translateY(-2px); }
  .cqh__askLink:focus-visible { outline: 2px solid var(--pg-fg); outline-offset: 4px; }

  @media (max-width: 760px) {
    .cqh:first-of-type { padding-top: 64px; }
    .cqh__heading { margin-bottom: 32px; }
    .cqh__topicLink { grid-template-columns: 40px 1fr; gap: 12px 16px; }
    .cqh__topicMeta { grid-column: 2; }
    .cqh__topicLink:hover { transform: none; }
    .cqh__askLink:hover { transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cqh__askLink, .cqh__topicLink { transition: none; }
  }
</style>
