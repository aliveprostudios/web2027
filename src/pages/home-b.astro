  }
  @keyframes featureParallax {
    from { transform: translateY(calc(-50% - var(--pf-shift))) scale(var(--pf-zoom-from)); }
    to { transform: translateY(calc(-50% + var(--pf-shift))) scale(var(--pf-zoom-to)); }
  }

  /* The credit floats over the image's bottom-left corner. Links to the case
