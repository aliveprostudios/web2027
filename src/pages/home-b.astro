    --pf-shift: 10%;
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: 140%;
    object-fit: cover;
    object-position: center 45%;
    transform: translateY(-50%) scale(var(--pf-zoom-from));
  }
  @supports (animation-timeline: view()) {
    .feature__img {
      animation-name: featureParallax;
      animation-duration: auto;
