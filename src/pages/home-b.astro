    font-family: var(--font-condensed);
    font-weight: 800;
    font-size: clamp(26px, 2.6vw, 40px);
    line-height: 1.04;
    text-transform: uppercase;
    color: var(--pg-fg);
    margin: 0 0 18px;
  }
  .intro__body { margin: 0; font-size: 17px; line-height: 1.6; color: var(--pg-fg2); max-width: 46ch; }

  @supports (animation-timeline: view()) {
    .intro__card {
      animation: introReveal linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 70%;
    }
  }
  @keyframes introReveal { from { opacity: 0; } to { opacity: 1; } }

  /* ---- 2b. Client logo wall ---------------------------------------------
     Eight tiles, four logos each. Every face runs the same 12s keyframe; its
     own `--k` pushes it a quarter-cycle later than the face beneath, and each
     tile carries a different `--offset`, so the wall ripples rather than
     flipping in unison. A face enters by swinging up from rotateX(90deg) and
     leaves by swinging away, split-flap style, under a shared perspective.
     Hover holds a tile still. With animations off (reduced motion, which
     base.css applies globally) only the first face shows, which is a plain
     static logo grid: the right fallback. */
  .clients { padding-top: 0; }
  .clients__eyebrow { color: var(--pg-fg); margin: 0 0 32px; }
  .clients__num { color: var(--orange-ink); }
  .clients__count { color: var(--pg-fg3); }
  .clients__heading { margin: 0 0 56px; }

  .clients__wall {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    perspective: 1400px;
  }

  .flip {
    --step: 3s;
    --cycle: calc(var(--step) * 4);
    position: relative;
    aspect-ratio: 461 / 297;
    transform-style: preserve-3d;
  }
  .flip:nth-child(1) { --offset: 0s; }
  .flip:nth-child(2) { --offset: 1.3s; }
  .flip:nth-child(3) { --offset: 2.1s; }
  .flip:nth-child(4) { --offset: 0.6s; }
  .flip:nth-child(5) { --offset: 1.7s; }
  .flip:nth-child(6) { --offset: 2.6s; }
  .flip:nth-child(7) { --offset: 0.9s; }
  .flip:nth-child(8) { --offset: 2.3s; }

  .flip__face {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform-origin: 50% 100%;
    backface-visibility: hidden;
    animation: flipFace var(--cycle) linear infinite both;
    animation-delay: calc(-1 * (var(--k) * var(--step) + var(--offset)));
    will-change: transform, opacity;
  }
  .flip__face:first-child { opacity: 1; }
  .flip:hover .flip__face { animation-play-state: paused; }
  .flip__face :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
  }

  /* One face's share of the cycle is 25%. It swings in over the first 5%,
     holds, and swings out over the last 4% of its slot; the rest of the
     cycle it is folded flat and invisible. */
  @keyframes flipFace {
    0%   { opacity: 0; transform: rotateX(90deg); }
    5%   { opacity: 1; transform: rotateX(0deg); }
    21%  { opacity: 1; transform: rotateX(0deg); }
    25%  { opacity: 0; transform: rotateX(-90deg); }
    100% { opacity: 0; transform: rotateX(-90deg); }
  }

  /* Rises into view on scroll, same device as the intro cards. */
  @supports (animation-timeline: view()) {
    .flip {
      animation: introReveal linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 60%;
    }
  }

