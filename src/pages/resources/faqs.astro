---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BgRails from '../../components/BgRails.astro';
import SiteNav from '../../components/SiteNav.astro';
import VideoHero from '../../components/VideoHero.astro';
import BookConsult from '../../components/BookConsult.astro';
import NextStep from '../../components/NextStep.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { faqGroups, allFaqs } from '../../lib/faqs';

/**
 * /resources/faqs
 *
 * Design B of the FAQ accordion, approved by Javad 2026-09-01 and moved here
 * from the `/faqs-b` draft in the same session. The parked original in
 * `src/pages/_resources/` is gone.
 *
 * The accordion and the FAQPage structured data are both generated from
 * `content/faqs.md`, so they cannot drift: adding a `### Question` and its
 * answer under a `## Group` adds it to the page, the schema, the menu count
 * and the Resources landing card in one edit.
 *
 * How it is built:
 *   - each `##` group is a section with an eyebrow and a real H2;
 *   - rows follow the pillar grid: mono index, question at a solid 600
 *     weight, the +/- glyph tucked beside the question, the answer opening in
 *     the question's own column;
 *   - the open question turns orange and takes the dot device;
 *   - open and close ANIMATE. The panel is a grid whose single row eases
 *     between 0fr and 1fr, which works in every current browser without
 *     measuring heights. `<details>` is kept for semantics and for a no-JS
 *     fallback, so the script intercepts the toggle: on open it sets the
 *     attribute and lets the row grow on the next frame, on close it shrinks
 *     the row first and removes the attribute when the transition ends. One
 *     item open per group, closed with the same motion.
 *
 * `CLAUDE.md` lists FAQPage as a non-negotiable.
 */
const path = '/resources/faqs';
const title = 'FAQs';
const description =
  'Answers to the questions we are asked most about brand strategy, timelines, ' +
  'pricing, and working with Alive ProStudios.';

const groups = faqGroups();
const faqs = allFaqs();

const schema = [
  {
    '@type': 'FAQPage',
    '@id': `https://aliveprostudios.com${path}#faq`,
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Resources', url: '/resources' },
  { name: title, url: path },
];
---

<BaseLayout {title} {description} {path} {schema} {breadcrumbs}>
  <div class="page-root">
    <BgRails />

    <section class="hero">
      <div class="hero__inner">
        <SiteNav />
        <div class="hero__copy">
          <p class="hero__crumb t-eyebrow">Resources&nbsp;&nbsp;·&nbsp;&nbsp;FAQs</p>
          <h1 class="hero__title t-h1">
            <span class="hero__line-mask"><span class="hero__line dot">Questions, answered</span></span>
          </h1>
          <p class="hero__caption">
            <span class="hero__caption-lead">{faqs.length} answers, no sales pitch.</span>{' '}
            <span class="hero__caption-tail">If yours is missing, ask us directly.</span>
          </p>
        </div>
      </div>
    </section>

    <VideoHero route={path} title="Alive ProStudios reel" />

    <main id="main">
      {
        groups.map((group, gi) => (
          <section class="faq section" data-faq-group>
            <p class="faq__eyebrow t-eyebrow z-content">
              <span class="faq__num">({String(gi + 1).padStart(2, '0')})</span>&nbsp;&nbsp;Questions
              &nbsp;&nbsp;<span class="faq__count">({group.items.length})</span>
            </p>
            <h2 class="faq__heading t-h2 dot z-content">{group.heading}</h2>

            <div class="faq__list z-content">
              {group.items.map((item, i) => (
                <details class="faq__item" data-faq-item open={gi === 0 && i === 0}>
                  <summary class="faq__row">
                    <span class="faq__index t-index">{String(i + 1).padStart(2, '0')}</span>
                    <span class="faq__q">
                      <span class="faq__q-text">{item.q}</span>
                      <span class="faq__glyph" aria-hidden="true" />
                    </span>
                  </summary>
                  <div class="faq__panel">
                    <div class="faq__panel-inner">
                      <p class="faq__a">{item.a}</p>
                    </div>
                  </div>
                </details>
              ))}
              <div class="faq__end" />
            </div>
          </section>
        ))
      }

      <BookConsult />
    </main>

    <NextStep sectionNum={String(groups.length + 1).padStart(2, '0')} />
    <SiteFooter backLabel="Resources" backHref="/resources" nextLabel="Contact" nextHref="/contact" />
  </div>
</BaseLayout>

<script>
  /* Animated <details>. The browser toggles `open` instantly, so the click is
     intercepted and the attribute is managed here around the transition.
     `data-open` drives the CSS; `open` keeps the semantics and the no-JS
     fallback (without this script the rows still open and close, just
     without motion, because [open] alone also shows the panel). */
  const DURATION = 420;

  function expand(item: HTMLDetailsElement) {
    item.open = true;
    // Two frames: one for `open` to lay the panel out at 0fr, one to start
    // the transition to 1fr.
    requestAnimationFrame(() => requestAnimationFrame(() => item.setAttribute('data-open', '')));
  }

  function collapse(item: HTMLDetailsElement) {
    item.removeAttribute('data-open');
    const panel = item.querySelector<HTMLElement>('.faq__panel');
    let done = false;
    const finish = () => {
      if (done) return;
      done = true;
      item.open = false;
    };
    panel?.addEventListener('transitionend', finish, { once: true });
    // Safety net if the transition never fires (reduced motion kills it).
    setTimeout(finish, DURATION + 60);
  }

  document.querySelectorAll<HTMLElement>('[data-faq-group]').forEach((group) => {
    // Hands the list to the script: the CSS no-JS fallback stands down.
    group.querySelector<HTMLElement>('.faq__list')?.setAttribute('data-js', '');
    const items = [...group.querySelectorAll<HTMLDetailsElement>('[data-faq-item]')];
    items.forEach((item) => {
      if (item.open) item.setAttribute('data-open', '');
      const summary = item.querySelector<HTMLElement>('summary');
      summary?.addEventListener('click', (event) => {
        event.preventDefault();
        if (item.open) {
          collapse(item);
        } else {
          items.filter((other) => other !== item && other.open).forEach(collapse);
          expand(item);
        }
      });
    });
  });
</script>

<style>
  .hero {
    position: relative;
    background: linear-gradient(180deg, var(--surface-hero-top) 0%, var(--surface-hero-bottom) 100%);
    color: #fff;
    padding-bottom: 88px;
    overflow: hidden;
  }
  .hero__inner { position: relative; z-index: var(--z-nav); }
  .hero__copy { padding: 56px var(--gutter) 0; }
  .hero__crumb {
    color: var(--brand-lime);
    margin: 0 0 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--brand-orange);
    width: fit-content;
    animation: heroFade 800ms var(--ease-settle) both 100ms;
  }
  .hero__title { margin: 0; }
  .hero__line-mask { display: block; overflow: hidden; }
  .hero__line { display: block; animation: heroRise var(--dur-hero) var(--ease-settle) both 150ms; }
  .hero__caption {
    margin: 32px 0 0;
    max-width: 720px;
    font-size: clamp(15px, 1.3vw, 17px);
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1.6;
    text-transform: uppercase;
    animation: heroFade 800ms var(--ease-settle) both 300ms;
  }
  .hero__caption-lead { color: #fff; }
  .hero__caption-tail { color: var(--brand-orange); }

  /* ---- Groups ---------------------------------------------------------- */
  .faq { padding-top: 0; }
  .faq:first-of-type { padding-top: 96px; }
  .faq__eyebrow { color: var(--pg-fg); margin: 0 0 28px; }
  .faq__num { color: var(--orange-ink); }
  .faq__count { color: var(--pg-fg3); }
  .faq__heading { margin: 0 0 48px; }

  .faq__list { display: flex; flex-direction: column; }
  .faq__end { border-top: 1px solid var(--pg-line); }

  /* ---- Rows: the pillar grid, index column then content ------------------- */
  .faq__item { border-top: 1px solid var(--pg-line); }

  .faq__row {
    display: grid;
    grid-template-columns: var(--col-num) 1fr;
    gap: clamp(24px, 3vw, 56px);
    align-items: baseline;
    padding: 22px 0;
    cursor: pointer;
    list-style: none;
  }
  .faq__row::-webkit-details-marker { display: none; }
  .faq__row:focus-visible { outline: 2px solid var(--brand-orange); outline-offset: 4px; }

  .faq__index { padding-top: 0.35em; }

  /* The glyph sits right after the question, so the eye never has to cross
     the page to find it. */
  .faq__q {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    color: var(--pg-fg);
    transition: color var(--dur-micro) ease, transform var(--dur-micro) var(--ease-settle);
  }
  .faq__q-text {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(18px, 1.6vw, 22px);
    line-height: 1.3;
    letter-spacing: -0.005em;
  }
  .faq__row:hover .faq__q { color: var(--orange-ink); transform: translateX(6px); }

  .faq__glyph { flex: none; position: relative; width: 14px; height: 14px; }
  .faq__glyph::before,
  .faq__glyph::after {
    content: '';
    position: absolute;
    background: var(--orange-ink);
    transition: transform var(--dur-move) var(--ease-settle);
  }
  .faq__glyph::before { left: 0; top: 6px; width: 14px; height: 2px; }
  .faq__glyph::after { left: 6px; top: 0; width: 2px; height: 14px; }
  /* The vertical bar rotates onto the horizontal one: + becomes − in motion. */
  .faq__item[data-open] .faq__glyph::after { transform: rotate(90deg); }
  .faq__item[data-open] .faq__glyph::before { transform: rotate(180deg); }

  /* The active question takes the orange and the dot, like every headline. */
  .faq__item[data-open] .faq__q { color: var(--orange-ink); }
  .faq__item[data-open] .faq__q-text::after {
    content: '';
    display: inline-block;
    width: 0.3em;
    height: 0.3em;
    margin-left: 0.25em;
    background: var(--brand-orange);
    border-radius: 999px;
    vertical-align: baseline;
  }

  /* ---- Panel: a one-row grid easing between 0fr and 1fr ------------------- */
  .faq__panel {
    display: grid;
    grid-template-rows: 0fr;
    grid-template-columns: var(--col-num) 1fr;
    column-gap: clamp(24px, 3vw, 56px);
    transition: grid-template-rows 420ms var(--ease-settle);
  }
  .faq__item[data-open] .faq__panel { grid-template-rows: 1fr; }
  .faq__panel-inner {
    grid-column: 2;
    min-height: 0;
    overflow: hidden;
  }
  .faq__a {
    margin: 0;
    padding: 4px 0 34px;
    max-width: 68ch;
    font-size: 18px;
    line-height: 1.65;
    color: var(--pg-fg2);
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 320ms ease 80ms, transform 420ms var(--ease-settle);
  }
  .faq__item[data-open] .faq__a { opacity: 1; transform: translateY(0); }

  /* No-JS fallback, scoped to lists the script never reached: there, [open]
     alone shows the panel. It must NOT apply once the script runs, because
     between `open` being set and `data-open` following two frames later the
     row would already be at full height and there would be nothing left to
     animate. That is exactly what happened in the first build. */
  .faq__list:not([data-js]) .faq__item[open] .faq__panel { grid-template-rows: 1fr; }
  .faq__list:not([data-js]) .faq__item[open] .faq__a { opacity: 1; transform: none; }

  @media (max-width: 760px) {
    .faq:first-of-type { padding-top: 64px; }
    .faq__heading { margin-bottom: 32px; }
    .faq__row { grid-template-columns: 40px 1fr; gap: 16px; padding: 18px 0; }
    .faq__panel { grid-template-columns: 40px 1fr; column-gap: 16px; }
    .faq__q { align-items: flex-start; gap: 14px; }
    .faq__glyph { margin-top: 0.45em; }
    .faq__a { font-size: 17px; padding-bottom: 26px; }
    .faq__row:hover .faq__q { transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__panel, .faq__a, .faq__q, .faq__glyph::before, .faq__glyph::after { transition: none; }
  }
</style>
