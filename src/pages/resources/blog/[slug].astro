---
import { getCollection } from 'astro:content';
import MasterPage from '../../../layouts/MasterPage.astro';
import { parseAnatomy } from '../../../lib/anatomy';

/** The blog posts. Article schema, and Related = the other posts. */
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, posts },
  }));
}

const { entry, posts } = Astro.props;
const path = `/resources/blog/${entry.id}`;
const caption = entry.data.caption?.trim() || undefined;
const anatomy = parseAnatomy(entry.body ?? '', caption);

const related = posts
  .filter((p) => p.id !== entry.id)
  .map((p, i) => ({ num: String(i + 1).padStart(2, '0'), title: p.data.title, url: `/resources/blog/${p.id}` }));

const article = {
  '@type': 'Article',
  '@id': `https://aliveprostudios.com${path}#article`,
  headline: entry.data.title,
  ...(entry.data.date ? { datePublished: entry.data.date } : {}),
  ...(entry.data.author ? { author: { '@type': 'Person', name: entry.data.author } } : {}),
  mainEntityOfPage: { '@id': `https://aliveprostudios.com${path}#page` },
  publisher: { '@id': 'https://aliveprostudios.com/#organization' },
  ...(entry.data.categories?.length ? { articleSection: entry.data.categories[0] } : {}),
  ...(entry.data.tags?.length ? { keywords: entry.data.tags.join(', ') } : {}),
};
---

<MasterPage
  inlineFigures
  topics={entry.data.tags ?? []}
  title={entry.data.title}
  description={entry.data.seoDescription}
  {path}
  {anatomy}
  {caption}
  {related}
  crumb="Resources  ·  Marketing Blog"
  relatedLabel="More Articles"
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Resources', url: '/resources' },
    { name: 'Marketing Blog', url: '/resources/blog' },
    { name: entry.data.title, url: path },
  ]}
  footerLabel="All Articles"
  footerHref="/resources/blog"
  {/* The page entity is a WebPage; the Article below is the ONE Article for
      this URL. Passing "Article" here emitted a second, thin Article entity
      (#page, name + description only) alongside the real one (#article), so
      the graph advertised two different Articles for the same page. */}
  schemaType="WebPage"
  extraSchema={[article]}
/>
