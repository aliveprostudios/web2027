---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BgRails from '../../components/BgRails.astro';
import SiteNav from '../../components/SiteNav.astro';
import VideoHero from '../../components/VideoHero.astro';
import BookConsult from '../../components/BookConsult.astro';
import NextStep from '../../components/NextStep.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { parseLanding } from '../../lib/landing';
import { galleryImages } from '../../lib/gallery';
import { VIDEO_LIBRARY } from '../../lib/videos';

/**
 * /work landing. Two children, Portfolio and Videos, read from
 * `content/landing/work.md` rather than hard-coded.
 *
 * Each row carries a live count from its own source, so the numbers cannot
 * drift from what the child pages actually contain.
 */
const path = '/work';
const title = 'Work';
const description =
  'A selection of recent brand transformations, creative productions, and ' +
  'strategic projects from Alive ProStudios.';

const landing = await parseLanding('work', '/work');

const COUNTS: Record<string, number> = {
  '/work/portfolio': galleryImages.length,
  '/work/videos': VIDEO_LIBRARY.length,
};

const children = landing?.children ?? [];

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: title, url: path },
];
---

<BaseLayout {title} {description} {path} {breadcrumbs}>
  <div class="page-root">
    <BgRails />

    <section class="hero">
      <div class="hero__inner">
        <SiteNav active={path} />
        <div class="hero__copy">
          <p class="hero__crumb t-eyebrow">Work</p>
          <h1 class="hero__title t-h1">
            <span class="hero__line-mask"><span class="hero__line dot">{landing?.heading || title}</span></span>
          </h1>
        </div>
      </div>
    </section>

    <VideoHero route={path} title="Alive ProStudios work reel" />

    <main id="main">
      {
        landing?.intro && (
          <section class="section">
            <p class="lede t-h4 z-content">{landing.intro}</p>
          </section>
        )
      }

      <section class="rows">
        {
          children.map((child) => (
            <a class="row z-content" href={child.url} data-stack>
              <span class="row__num">{child.num}</span>
              <div class="row__body">
                <h2 class="row__name">
                  {child.name}
                  <span class="row__dot" />
                </h2>
                {child.blurb && <p class="row__blurb">{child.blurb}</p>}
              </div>
              <span class="row__explore">
                <span>{COUNTS[child.url] ?? ''}</span>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 17L17 7M9 7h8v8"></path>
                </svg>
              </span>
            </a>
          ))
        }
        <div class="rows__end"></div>
      </section>

      <BookConsult />
    </main>

    <NextStep sectionNum="03" />
    <SiteFooter nextLabel="Projects & Campaigns" nextHref="/work/portfolio" />
  </div>
</BaseLayout>

<style>
  .hero {
    position: relative;
    background: linear-gradient(180deg, var(--surface-hero-top) 0%, var(--surface-hero-bottom) 100%);
    color: #fff;
    padding-bottom: 88px;
    overflow: hidden;
  }
  .hero__inner { position: relative; z-index: var(--z-nav); }
  .hero__copy { padding: 56px var(--gutter) 0; }
  .hero__crumb {
    color: var(--brand-lime);
    margin: 0 0 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--brand-orange);
    width: fit-content;
    animation: heroFade 800ms var(--ease-settle) both 100ms;
  }
  .hero__title { margin: 0; }
  .hero__line-mask { display: block; overflow: hidden; }
  .hero__line { display: block; animation: heroRise var(--dur-hero) var(--ease-settle) both 150ms; }

  .lede { max-width: 760px; margin: 0; }

  .rows { padding: 0 var(--gutter) 64px; }

  .row {
    display: grid;
    grid-template-columns: var(--col-num) 1fr auto;
    gap: clamp(24px, 3vw, 56px);
    align-items: center;
    border-top: 1px solid var(--pg-line);
    padding: 48px 0;
    text-decoration: none;
    color: var(--pg-fg);
    transform: translateX(0);
    transition: transform var(--dur-micro) var(--ease-settle), color var(--dur-micro) ease;
  }
  .row:hover { transform: translateX(12px); color: var(--brand-orange); }

  .row__num {
    font-family: var(--font-condensed);
    font-weight: 800;
    font-size: 56px;
    line-height: 1;
    color: var(--brand-orange);
  }

  .row__name {
    margin: 0 0 10px;
    font-size: clamp(28px, 3.6vw, 60px);
    font-weight: 200;
    letter-spacing: -0.01em;
    line-height: 1.05;
    color: inherit;
    text-transform: none;
  }
  .row__dot {
    display: inline-block;
    width: 0.14em;
    height: 0.14em;
    margin-left: 0.06em;
    background: var(--brand-orange);
    border-radius: 999px;
  }

  .row__blurb {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--pg-fg2);
    max-width: 620px;
  }

  .row__explore {
    display: flex;
    align-items: center;
    gap: 14px;
    flex: none;
    color: var(--brand-orange);
    font-family: var(--font-mono);
    font-size: 15px;
    transform: translate(0, 0);
    transition: transform var(--dur-micro) var(--ease-settle);
  }
  .row:hover .row__explore { transform: translate(4px, -4px); }

  .rows__end { border-top: 1px solid var(--pg-line); }

  @media (max-width: 760px) {
    .row__explore { margin-left: 68px; }
  }
</style>
