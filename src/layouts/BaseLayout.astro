---
import '../styles/tokens.css';
import '../styles/base.css';
import SiteMenu from '../components/SiteMenu.astro';

/**
 * Document shell: head, fonts, theme bootstrap, SEO and structured data.
 * STYLEGUIDE.md §8 (SEO/meta) and the non-negotiables in CLAUDE.md.
 */
interface Props {
  title: string;
  description?: string | undefined;
  /** Canonical path for THIS page. Never inherit the homepage canonical. */
  path: string;
  /** Extra JSON-LD entities beyond Organization + BreadcrumbList. */
  schema?: Record<string, unknown>[];
  breadcrumbs?: Array<{ name: string; url: string }>;
  /** Keep this page out of the index. `follow` so its links still pass equity.
   *  Pair it with the sitemap filter in astro.config.mjs. */
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  schema = [],
  breadcrumbs = [],
  noindex = false,
} = Astro.props;

const SITE = 'https://aliveprostudios.com';
const canonical = new URL(path, SITE).href;
const pageTitle = `${title} | Alive ProStudios`;

/**
 * Share card (STYLEGUIDE.md §8): 1200x630, dark grey ground, white Condensed
 * title, orange dot. One card for the whole site. Absolute URL because every
 * scraper that reads it is off-origin, and `summary_large_image` without an
 * image renders as a broken preview rather than falling back to a small card.
 */
const ogImage = new URL('/assets/og-image.jpg', SITE).href;

const organization = {
  '@type': 'Organization',
  '@id': `${SITE}/#organization`,
  name: 'Alive ProStudios Inc.',
  url: SITE,
  logo: `${SITE}/assets/logo-full.svg`,
  foundingDate: '1997',
  email: 'info@aliveprostudios.com',
  telephone: '+1-905-553-3044',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Toronto',
    addressRegion: 'ON',
    addressCountry: 'CA',
  },
};

const breadcrumbList =
  breadcrumbs.length > 0
    ? {
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((crumb, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: crumb.name,
          item: new URL(crumb.url, SITE).href,
        })),
      }
    : null;

const graph = [organization, breadcrumbList, ...schema].filter(Boolean);
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Google Tag Manager. GTM asks to sit as high in the head as possible.
         The inline snippet is allowed by the CSP through a sha256 hash that
         `scripts/postbuild.mjs` computes from the built HTML on every build,
         so editing a single character here re-hashes automatically. The
         googletagmanager.com origins it needs are declared there too. -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', 'GTM-PJLQRZC');
    </script>
    <!-- End Google Tag Manager -->

    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/svg+xml" href="/assets/icon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Alive ProStudios" />
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Alive ProStudios: clarity, consistency, growth." />
    <meta property="og:locale" content="en_CA" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Barlow:wght@200;300;400;500;600;700&family=Barlow+Condensed:wght@700;800&family=JetBrains+Mono:wght@400&display=swap"
    />

    <script is:inline>
      // Applied before first paint so the theme never flashes.
      (function () {
        try {
          var stored = localStorage.getItem('aps-theme');
          document.documentElement.dataset.themeInit = stored === 'dark' ? 'dark' : 'light';
        } catch (e) {
          document.documentElement.dataset.themeInit = 'light';
        }
      })();
    </script>

    <script is:inline type="application/ld+json" set:html={jsonLd} />
  </head>

  <body data-theme="light">
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-PJLQRZC"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->

    <a class="skip-link" href="#main">Skip to content</a>
    <slot />

    <!-- Outside .page-root on purpose: a fixed overlay nested inside an
         `overflow: hidden` / `overflow-x: clip` ancestor gets clipped. -->
    <SiteMenu active={path} />

    <script is:inline>
      document.body.dataset.theme = document.documentElement.dataset.themeInit || 'light';
    </script>
  </body>
</html>
