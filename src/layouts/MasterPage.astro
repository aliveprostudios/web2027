---
import BaseLayout from './BaseLayout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { figure } from '../lib/figures';
import { isImageBlock } from '../lib/anatomy';
import BgRails from '../components/BgRails.astro';
import SiteNav from '../components/SiteNav.astro';
import VideoHero from '../components/VideoHero.astro';
import BookConsult from '../components/BookConsult.astro';
import RelatedServices from '../components/RelatedServices.astro';
import NextStep from '../components/NextStep.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { splitSentences, type Anatomy } from '../lib/anatomy';
import type { RelatedItem } from '../components/RelatedServices.astro';

/**
 * Master Page Template (STYLEGUIDE.md §9).
 *
 * Section order is locked:
 *   1 Hero · 2 VideoHero · 3 Why It Matters · 4 Content rows · 5 Quote band
 *   6 Closing statement · 7 BookConsult · 8 Related Services · 9 NextStep
 *   10 Footer
 *
 * A slot with no source is omitted, never filled. See TEMPLATE-ANATOMY.md §3.
 */
interface Props {
  title: string;
  description?: string | undefined;
  path: string;
  anatomy: Anatomy;
  /** Frontmatter caption. Falls back to anatomy.caption per §9. */
  caption?: string | undefined;
  videoId?: string | undefined;
  /** Breadcrumb eyebrow above the H1, derived from the route by the caller. */
  crumb: string;
  /** Related rows, already resolved from the collection. */
  related?: RelatedItem[];
  relatedLabel?: string;
  breadcrumbs: Array<{ name: string; url: string }>;
  footerLabel: string;
  footerHref: string;
  /** schema.org type for this page. Service pages are Services; the rest WebPage. */
  schemaType?: string;
  /** Additional JSON-LD entities to add to the graph (e.g. Article, FAQPage). */
  extraSchema?: Record<string, unknown>[];
  /**
   * Render slot 4 images INSIDE the text column, in the order they were
   * authored, instead of pulling them out to a full-bleed band after the row.
   *
   * Long-form articles read as one column, so a diagram belongs where the
   * sentence that introduces it left off. Service pages keep the full-bleed
   * default: their one diagram is a poster, not an illustration, and
   * `/alive-pro/our-system` depends on it (CLAUDE.md).
   */
  inlineFigures?: boolean;
  /**
   * Topic labels shown after the closing statement. Articles only.
   *
   * Assigned by `npm run blog-tags` from `content/taxonomy.md`, never by hand.
   * They are labels, not links: a tag archive holding one post is thin content,
   * so the tags earn their keep as `keywords` on the Article JSON-LD and as an
   * at-a-glance summary, not as another set of routes to crawl.
   */
  topics?: string[];
}

const {
  title,
  description,
  path,
  anatomy,
  caption,
  videoId,
  crumb,
  related = [],
  relatedLabel = 'Related Services',
  breadcrumbs,
  footerLabel,
  footerHref,
  schemaType = 'Service',
  extraSchema = [],
  inlineFigures = false,
  topics = [],
} = Astro.props;

const heroCaption = caption ?? anatomy.caption;

// §3: the caption is two-tone. First sentence white, the remainder brand orange.
const captionParts = heroCaption ? splitSentences(heroCaption) : [];
const captionLead = captionParts[0] ?? '';
const captionRest = captionParts.slice(1).join(' ');

const schema = [
  schemaType === 'Service'
    ? {
        '@type': 'Service',
        '@id': `https://aliveprostudios.com${path}#service`,
        name: title,
        ...(description ? { description } : {}),
        provider: { '@id': 'https://aliveprostudios.com/#organization' },
        areaServed: ['CA', 'US', 'DE'],
      }
    : {
        '@type': schemaType,
        '@id': `https://aliveprostudios.com${path}#page`,
        name: title,
        ...(description ? { description } : {}),
        isPartOf: { '@id': 'https://aliveprostudios.com/#organization' },
      },
  ...extraSchema,
];

/**
 * Heading level for a slot 4 ITEM.
 *
 * Section heads are always h2. An item is h3 when something above it on the
 * page is already an h2, which is either slot 3's heading or a section head.
 * With neither, as on Testimonials, the items ARE the page's top-level
 * headings and must be h2, or the document jumps straight from h1 to h3.
 */
const hasH2Above = Boolean(anatomy.h2) || anatomy.rows.some((row) => row.section);
const itemTag = hasH2Above ? 'h3' : 'h2';
---

<BaseLayout {title} {description} {path} {schema} {breadcrumbs}>
  <div class="page-root">
    <BgRails />

    <!-- 1. Hero -->
    <section class="hero">
      <div class="hero__inner">
        <SiteNav active={path} />

        <div class="hero__copy">
          <p class="hero__crumb t-eyebrow">{crumb}</p>

          <h1 class="hero__title t-h1">
            <span class="hero__line-mask">
              <span class="hero__line dot">{title}</span>
            </span>
          </h1>

          {
            heroCaption && (
              <p class="hero__caption">
                <span class="hero__caption-lead">{captionLead}</span>
                {captionRest && ` ${captionRest}`}
              </p>
            )
          }
        </div>
      </div>
    </section>

    <!-- 2. VideoHero -->
    <VideoHero route={path} videoId={videoId} title={`${title} reel`} />

    <main id="main">
      <!-- 3. Why It Matters -->
      {
        anatomy.h2 && (
          <section class="why section" data-stack>
            <p class="why__label t-eyebrow z-content">
              <span class="why__num">(01)</span>&nbsp;&nbsp;Why It Matters
            </p>

            <div class="z-content">
              <h2 class="t-h2">{anatomy.h2}</h2>

              {anatomy.statement && (
                <p class="why__statement t-h4">
                  <Fragment set:html={anatomy.statement.lead} />{' '}
                  <span class="muted" set:html={anatomy.statement.muted} />{' '}
                  <Fragment set:html={anatomy.statement.tail} />
                </p>
              )}

              {anatomy.intro.length > 0 && (
                <div class="why__body md">
                  {anatomy.intro.map((block) =>
                    block.kind === 'p' ? (
                      <p set:html={block.html} />
                    ) : block.kind === 'image' ? (
                      <figure class="md__figure">
                        {figure(block.src).kind === 'svg' ? (
                          <img
                            src={(figure(block.src) as { src: string }).src}
                            alt={block.alt}
                            width={(figure(block.src) as { width: number }).width}
                            height={(figure(block.src) as { height: number }).height}
                            loading="lazy"
                            decoding="async"
                          />
                        ) : (
                          <Image
                            src={(figure(block.src) as { image: ImageMetadata }).image}
                            alt={block.alt}
                            widths={[720, 1440]}
                            sizes="720px"
                            loading="lazy"
                            decoding="async"
                          />
                        )}
                      </figure>
                    ) : (
                      <ul>
                        {block.items.map((item) => (
                          <li set:html={item} />
                        ))}
                      </ul>
                    ),
                  )}
                </div>
              )}

              {anatomy.stat && (
                <div class="stat">
                  <div class="stat__figure">{anatomy.stat.figure}</div>
                  <p class="stat__caption">
                    <Fragment set:html={anatomy.stat.caption.lead} />{' '}
                    <span class="stat__strong" set:html={anatomy.stat.caption.muted} />
                  </p>
                </div>
              )}
            </div>
          </section>
        )
      }

      <!-- 4. Content rows -->
      {
        anatomy.rows.length > 0 && (
          <section class="rows">
            {anatomy.rows.map((row) => (
              <Fragment>
                <div
                  class:list={[
                    'row',
                    'z-content',
                    row.section && 'row--section',
                    !row.section && !row.num && 'row--plain',
                    row.blocks.some((b) => isImageBlock(b) && b.variant !== 'full') &&
                      'row--illustrated',
                  ]}
                  data-stack
                >
                  {row.num && <span class="row__num">{row.num}</span>}
                  <div>
                    {row.blocks
                      .filter(isImageBlock)
                      .filter((block) => block.variant !== 'full')
                      .map((block) => {
                        const fig = figure(block.src);
                        return (
                          <figure class:list={['row__portrait', `row__portrait--${block.variant}`]}>
                            {fig.kind === 'svg' ? (
                              <img
                                src={fig.src}
                                alt={block.alt}
                                width={fig.width}
                                height={fig.height}
                                loading="lazy"
                                decoding="async"
                              />
                            ) : (
                              <Image
                                src={fig.image}
                                alt={block.alt}
                                widths={[320, 640]}
                                sizes="(max-width: 760px) 60vw, 300px"
                                loading="lazy"
                                decoding="async"
                              />
                            )}
                          </figure>
                        );
                      })}
                    {row.section ? (
                      <h2 class="t-h2 row__heading">{row.heading}</h2>
                    ) : (
                      <Fragment>
                        {itemTag === 'h2' ? (
                          <h2 class="t-h3 row__heading">{row.heading}</h2>
                        ) : (
                          <h3 class="t-h3 row__heading">{row.heading}</h3>
                        )}
                      </Fragment>
                    )}
                    <div class="md">
                      {row.blocks
                        .filter((block) =>
                          inlineFigures
                            ? !(isImageBlock(block) && block.variant !== 'full')
                            : block.kind !== 'image',
                        )
                        .map((block) =>
                          block.kind === 'image' ? (
                            <figure class="md__figure md__figure--inline">
                              {figure(block.src).kind === 'svg' ? (
                                <img
                                  src={(figure(block.src) as { src: string }).src}
                                  alt={block.alt}
                                  width={(figure(block.src) as { width: number }).width}
                                  height={(figure(block.src) as { height: number }).height}
                                  loading="lazy"
                                  decoding="async"
                                />
                              ) : (
                                <Image
                                  src={(figure(block.src) as { image: ImageMetadata }).image}
                                  alt={block.alt}
                                  widths={[480, 720, 1080]}
                                  sizes="(max-width: 760px) 92vw, 720px"
                                  loading="lazy"
                                  decoding="async"
                                />
                              )}
                            </figure>
                          ) : block.kind === 'p' ? (
                            <p set:html={block.html} />
                          ) : (
                            <div class="row__list">
                              {block.label && <p class="row__list-label t-eyebrow">{block.label}</p>}
                              <ul>
                                {block.items.map((item) => (
                                  <li set:html={item} />
                                ))}
                              </ul>
                            </div>
                          ),
                        )}
                    </div>
                  </div>
                </div>

                {(inlineFigures ? [] : row.blocks)
                  .filter(isImageBlock)
                  .filter((block) => block.variant === 'full')
                  .map((block) => {
                    const fig = figure(block.src);
                    return (
                      <figure class="rows__figure">
                        {fig.kind === 'svg' ? (
                          <img
                            src={fig.src}
                            alt={block.alt}
                            width={fig.width}
                            height={fig.height}
                            loading="lazy"
                            decoding="async"
                          />
                        ) : (
                          <Image
                            src={fig.image}
                            alt={block.alt}
                            widths={[768, 1280, 1800]}
                            sizes="100vw"
                            loading="lazy"
                            decoding="async"
                          />
                        )}
                      </figure>
                    );
                  })}
              </Fragment>
            ))}
          </section>
        )
      }

      <!-- 5. Quote band -->
      {
        anatomy.quote && (
          <section class="quote">
            <div class="quote__inner z-content">
              <blockquote class="t-h4 quote__text" set:html={anatomy.quote.html} />
              {anatomy.quote.name && (
                <p class="quote__by">
                  {anatomy.quote.name}
                  {anatomy.quote.role && <span class="quote__role">{anatomy.quote.role}</span>}
                </p>
              )}
            </div>
          </section>
        )
      }

      <!-- 6. Closing statement -->
      {
        anatomy.closing && (
          <section class="section">
            <p class="closing t-h4 z-content">
              <Fragment set:html={anatomy.closing.lead} />{' '}
              <span class="muted" set:html={anatomy.closing.muted} />{' '}
              <Fragment set:html={anatomy.closing.tail} />
            </p>
          </section>
        )
      }

      {
        topics.length > 0 && (
          <section class="section topics">
            <p class="topics__label t-eyebrow z-content">Topics</p>
            <ul class="topics__list z-content">
              {topics.map((topic) => (
                <li class="topics__item">{topic}</li>
              ))}
            </ul>
          </section>
        )
      }

      <!-- 7. Book a Consult -->
      <BookConsult />

      <!-- 8. Related Services -->
      {
        related.length > 0 && (
          <section class="section">
            <RelatedServices items={related} num="02" label={relatedLabel} />
          </section>
        )
      }
    </main>

    <!-- 9. Next Step -->
    <NextStep sectionNum="03" />

    <!-- 10. Footer -->
    <SiteFooter nextHref={footerHref} nextLabel={footerLabel} />
  </div>
</BaseLayout>

<style>
  /* ---- 1. Hero (§3) — theme-invariant --------------------------------- */
  .hero {
    position: relative;
    background: linear-gradient(180deg, var(--surface-hero-top) 0%, var(--surface-hero-bottom) 100%);
    color: #fff;
    padding-bottom: 88px;
    overflow: hidden;
  }

  /* Nav must beat the video (§1.5). */
  .hero__inner { position: relative; z-index: var(--z-nav); }

  .hero__copy { padding: 56px var(--gutter) 0; }

  .hero__crumb {
    color: var(--brand-lime);
    margin: 0 0 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--brand-orange);
    width: fit-content;
    animation: heroFade 800ms var(--ease-settle) both 100ms;
  }

  .hero__title { margin: 0; }
  .hero__line-mask { display: block; overflow: hidden; }
  .hero__line {
    display: block;
    animation: heroRise var(--dur-hero) var(--ease-settle) both 150ms;
  }

  .hero__caption {
    max-width: 680px;
    margin: 40px 0 0;
    font-weight: 600;
    font-size: 22px;
    line-height: 1.5;
    text-transform: uppercase;
    color: var(--brand-orange);
    animation: heroFade 800ms var(--ease-settle) both 600ms;
  }
  .hero__caption-lead { color: #fff; }

  /* ---- 3. Why It Matters ---------------------------------------------- */
  .why {
    display: grid;
    grid-template-columns: var(--col-label) 1fr;
    gap: 40px;
    align-items: start;
  }
  .why__label { color: var(--pg-fg); margin: 0; }
  .why__num { color: var(--orange-ink); }

  .why__statement { max-width: 680px; margin: 56px 0 0; }

  /* An image in slot 3 stays inside the measure; slot 4 goes full bleed UNLESS
     the page asked for inline figures (long-form articles), in which case a
     diagram sits in the text column where it was authored.

     Spacing is symmetrical and larger than paragraph rhythm (32px) so the
     figure reads as its own beat rather than as part of the paragraph above
     it. `clamp` carries that down to mobile without a second breakpoint. */
  .md__figure { margin: clamp(28px, 6vw, 48px) 0; max-width: 720px; }
  .md__figure img { display: block; width: 100%; height: auto; border-radius: 8px; }

  /* Only a figure that ENDS its container drops the bottom gap; the container
     supplies that space. A figure with copy after it keeps both margins, or the
     paragraph below collides with the artwork. */
  .why__body .md__figure:last-child { margin-bottom: 0; }

  /* An inline figure is a sibling of <p> inside `.md`, whose own rhythm is
     margin-top only. Both margins are declared so neither collapses to the
     paragraph value, and the figure keeps equal air on both sides. */
  .md__figure--inline {
    margin-top: clamp(28px, 6vw, 48px);
    margin-bottom: clamp(28px, 6vw, 48px);
    width: 100%;
  }
  .md__figure--inline + p { margin-top: 0; }
  .why__body { margin-top: 32px; }

  /* Stat block (§5) */
  .stat {
    border-top: 2px solid var(--brand-orange);
    padding-top: 24px;
    margin-top: 64px;
    max-width: 680px;
  }
  .stat__figure {
    font-family: var(--font-condensed);
    font-weight: 800;
    font-size: clamp(64px, 6vw, 112px);
    line-height: 1;
    color: var(--orange-ink);
  }
  .stat__caption {
    margin: 16px 0 0;
    font-weight: 600;
    font-size: 15px;
    line-height: 1.5;
    text-transform: uppercase;
    color: var(--pg-fg3);
  }
  .stat__strong { color: var(--pg-fg); }

  /* ---- 4. Numbered rows ------------------------------------------------ */
  .rows { padding: 0 var(--gutter) 64px; }

  .row {
    display: grid;
    grid-template-columns: var(--col-num) 1fr;
    gap: clamp(24px, 3vw, 56px);
    border-top: 1px solid var(--pg-line);
    padding: 56px 0;
    align-items: start;
  }

  /* A section head (`---` before the heading in the Markdown). It is NOT part of
     the numbered run above it, so it drops the number column and the hairline
     that chains the rows together, and takes the H2 scale like the slot 3
     heading it is a peer of. The space above is what separates the sections. */
  .row--section {
    grid-template-columns: 1fr;
    border-top: none;
    padding: 112px 0 56px;
  }
  .row--section .row__heading { margin-bottom: 32px; }

  /* An item in a `***` section: still an item, so it keeps the hairline and the
     H3 scale, it just has no number. The body is pinned to the second column so
     it stays on the same left edge as the numbered items elsewhere. */
  .row--plain > div { grid-column: 2; }

  /* Edge to edge. `.rows` is padded by exactly one gutter each side, so pulling
     the figure back by that much lands it on the viewport edges. Measuring off
     the container's own padding rather than 100vw keeps it exact when a classic
     scrollbar is present, which 100vw does not account for.

     The ground matches the page in BOTH themes, exactly as `.pillars__figure`
     does on Home. The one diagram that uses this slot bakes its own opaque
     capsule into the artwork; only the transparent margins around it are CSS
     controlled, so forcing white there painted a white band across a dark page
     instead of blending into it. */
  .rows__figure {
    position: relative;
    z-index: var(--z-content);
    margin: 0 calc(var(--gutter) * -1) 56px;
    background: var(--pg-bg);
  }
  .rows__figure img { display: block; width: 100%; height: auto; }

  /* ---- Illustrated row: image beside the text -------------------------
     A `"portrait"` image stays INSIDE the row instead of going full bleed,
     which is what a headshot or a product shot wants. The body cell becomes
     two columns: the picture spans both rows on the left, heading and copy
     stack on the right. */
  .row--illustrated > div {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: 8px clamp(28px, 3.5vw, 56px);
    align-items: start;
  }
  .row--illustrated .row__portrait { grid-column: 1; grid-row: 1 / 3; margin: 0; }
  .row--illustrated .row__heading { grid-column: 2; grid-row: 1; }
  .row--illustrated .md { grid-column: 2; grid-row: 2; }

  /* One ratio for every portrait, so two headshots shot differently still
     line up. §5 specifies 4:5 at a 12px radius. */
  .row__portrait img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
  }
  /* People only. An `aside` image keeps its own shape. */
  .row__portrait--portrait img { aspect-ratio: 4 / 5; object-fit: cover; }

  /* A person is not a section: the name sits under the section head that
     introduces them, so it drops well below the H3 display scale. */
  .row--illustrated:not(.row--section) .row__heading {
    font-size: clamp(22px, 2vw, 30px);
    line-height: 1.1;
    margin-bottom: 4px;
  }

  /* The role line: a paragraph that is nothing but bold text. Takes the H5
     kicker role (§1.3) so it reads as a title rather than as body copy. */
  .row--illustrated .md > p:has(> strong:only-child) {
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.14em;
    line-height: 1.5;
    text-transform: uppercase;
    color: var(--orange-ink);
    max-width: none;
    margin: 0 0 20px;
  }
  .row--illustrated .md > p:has(> strong:only-child) strong { color: inherit; }

  .row__num {
    font-family: var(--font-condensed);
    font-weight: 800;
    font-size: 56px;
    line-height: 1;
    color: var(--orange-ink);
  }

  .row__heading { margin: 0 0 20px; }

  .row__list { margin-top: 40px; max-width: 720px; }
  .row__list-label { margin: 0 0 20px; color: var(--pg-fg); }
  /* A paragraph closing out a labelled list needs the same rhythm as p + p. */
  .row__list + p { margin-top: 32px; }

  /* ---- 5. Quote band --------------------------------------------------- */
  .quote { background: var(--pg-band); padding: 96px var(--gutter); }
  .quote__inner { max-width: 960px; margin: 0 auto; }
  .quote__text { margin: 0; }
  .quote__by {
    margin: 32px 0 0;
    font-weight: 700;
    font-size: 15px;
    color: var(--pg-fg);
  }
  .quote__role {
    margin-left: 12px;
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pg-fg3);
  }

  /* ---- 6. Closing ------------------------------------------------------ */
  .closing { max-width: 760px; margin: 0; }

  /* ---- Topics (articles only) ------------------------------------------
     Labels, not links. `--pg-band` keeps them legible in both themes without
     introducing a second accent. */
  .topics__label { margin: 0 0 16px; color: var(--pg-fg3); }
  .topics__list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .topics__item {
    padding: 7px 14px;
    border: 1px solid var(--pg-line);
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--pg-fg2);
    background: var(--pg-band);
  }

  /* ---- Mobile ----------------------------------------------------------
     The global `[data-stack]` rule in base.css stacks the ROW, but it cannot
     reach the illustrated row's inner grid, which would otherwise keep a
     260px picture beside the copy on a 390px screen. */
  @media (max-width: 760px) {
    .row--illustrated > div { grid-template-columns: 1fr; gap: 20px; }
    .row--illustrated .row__portrait {
      grid-column: 1;
      grid-row: auto;
      max-width: 200px;
    }
    .row--illustrated .row__heading,
    .row--illustrated .md { grid-column: 1; grid-row: auto; }
    .row--illustrated:not(.row--section) .row__heading { font-size: 26px; }
  }
</style>
