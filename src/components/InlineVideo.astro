---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { parseVideoUrl, watchUrl, aspectOf, posterName, titleOf } from '../lib/videos';

/**
 * A video inside body copy, at column width.
 *
 * POSTER FRAME FIRST, iframe on click. This is the same rule `/work/videos`
 * follows and for the same reason: an embed that mounts on load phones the
 * provider, costs the page its performance budget, and a case study carrying
 * three of them is unusable. Clicking swaps the poster for the player in
 * place, so the video stays in the reading column rather than opening a modal.
 *
 * The frame's aspect comes from the video's REAL dimensions in
 * `content/work/video-meta.json`. Never assume 16:9 here: assuming it is what
 * makes a source letterbox inside its own iframe, and the box model cannot see
 * that happening.
 *
 * A URL the parser does not recognize renders nothing rather than an empty
 * frame, matching "a slot with no source is omitted, not filled".
 */
interface Props {
  url: string;
}

const { url } = Astro.props;
const video = parseVideoUrl(url);

const posters = import.meta.glob<{ default: ImageMetadata }>(
  '../../content/assets/video-posters/*.jpg',
  { eager: true },
);

const file = video ? posterName(video) : null;
const poster = file
  ? (posters[`../../content/assets/video-posters/${file}`]?.default ?? null)
  : null;

const label = (video && titleOf(video)) ?? 'video';
const aspect = video ? aspectOf(video) : 16 / 9;
---

{
  video && (
    <figure class="cs-video" style={`--video-aspect:${aspect}`}>
      <button
        type="button"
        class="cs-video__btn"
        data-inline-video={watchUrl(video)}
        data-inline-video-label={label}
        aria-label={`Play: ${label}`}
      >
        {poster ? (
          <Image src={poster} alt="" widths={[768, 1280]} sizes="(max-width: 860px) 100vw, 860px" loading="lazy" decoding="async" />
        ) : (
          <span class="cs-video__blank" />
        )}
        <span class="cs-video__play" aria-hidden="true">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8 5v14l11-7z" />
          </svg>
        </span>
      </button>
    </figure>
  )
}

<style>
  .cs-video {
    margin: clamp(28px, 6vw, 48px) 0;
    width: 100%;
    position: relative;
    z-index: var(--z-content);
  }

  .cs-video__btn {
    display: block;
    width: 100%;
    aspect-ratio: var(--video-aspect, 1.7778);
    padding: 0;
    border: none;
    background: var(--pg-bg2, #111);
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    position: relative;
  }

  .cs-video__btn :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cs-video__blank {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* The play badge is the only affordance, so it must read on any frame. */
  .cs-video__play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 68px;
    height: 68px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--brand-orange);
    color: #fff;
    transition: transform 0.25s ease;
  }

  .cs-video__btn:hover .cs-video__play,
  .cs-video__btn:focus-visible .cs-video__play {
    transform: scale(1.08);
  }

  /* The player is built by the click handler, so it never carries Astro's
     scoping attribute and a plain `.cs-video__frame` rule would not match it.
     Scope through the figure instead and mark the runtime nodes global. */
  .cs-video :global(.cs-video__frame) {
    width: 100%;
    aspect-ratio: var(--video-aspect, 1.7778);
    border-radius: 8px;
    overflow: hidden;
  }

  .cs-video :global(.cs-video__frame iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .cs-video__play { transition: none; }
  }
</style>

<script>
  // Build the iframe only on click, and replace the button with it so nothing
  // keeps playing behind a poster the visitor thinks they closed.
  document.querySelectorAll<HTMLButtonElement>('[data-inline-video]').forEach((button) => {
    button.addEventListener('click', () => {
      const src = button.dataset.inlineVideo;
      const label = button.dataset.inlineVideoLabel ?? 'video';
      if (!src) return;

      const frame = document.createElement('div');
      frame.className = 'cs-video__frame';

      const iframe = document.createElement('iframe');
      iframe.src = src;
      iframe.title = label;
      iframe.allow = 'autoplay; fullscreen; picture-in-picture';
      iframe.setAttribute('allowfullscreen', '');

      frame.appendChild(iframe);
      button.replaceWith(frame);
    });
  });
</script>
