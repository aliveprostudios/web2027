---
/**
 * Book a Consult, the orange CTA block (STYLEGUIDE.md §4.5).
 * Full-bleed brand orange, theme-invariant.
 */
interface Props {
  lineLight?: string;
  lineBold?: string;
  lineClose?: string;
}

const {
  lineLight = 'Fragmented Marketing',
  lineBold = 'Costs More Than',
  lineClose = 'You Think',
} = Astro.props;

const MARQUEE = ["Let's talk", '·', 'Book a consult', '·', 'Request a quote', '·'];
---

<section class="cta" aria-labelledby="cta-heading">
  <div class="cta__grid z-content" data-stack>
    <div>
      <p class="cta__eyebrow t-eyebrow">Book a Consult</p>

      <h2 class="cta__heading" id="cta-heading">
        <span class="cta__light">{lineLight}</span>
        <span class="cta__bold">{lineBold}</span>
        <span class="cta__close">{lineClose}</span>
      </h2>

      <div class="cta__actions">
        <a href="/contact" class="aps-btn aps-btn-dark">
          <span class="roll"><span>Book a Consult</span><span>Book a Consult</span></span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17L17 7M9 7h8v8"></path>
          </svg>
        </a>
        <a href="/work" class="aps-btn aps-btn-ghost">
          <span class="roll"><span>Explore Our Work</span><span>Explore Our Work</span></span>
        </a>
        <a href="tel:+19055533044" class="cta__phone">905-553-3044</a>
      </div>
    </div>

    <a href="/contact" class="cta__badge" aria-label="Book a consult">
      <svg viewBox="0 0 200 200" class="cta__badge-ring" aria-hidden="true">
        <defs>
          <path id="ctaCircle" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0"></path>
        </defs>
        <text><textPath href="#ctaCircle">Book a consult · 29 years of brand marketing · </textPath></text>
      </svg>
      <span class="cta__badge-core">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 17L17 7M9 7h8v8"></path>
        </svg>
      </span>
    </a>
  </div>

  <div class="cta__marquee marquee z-content" aria-hidden="true">
    <div class="marquee__track">
      <div class="marquee__half">{MARQUEE.map((word) => <span>{word}</span>)}</div>
      <div class="marquee__half">{MARQUEE.map((word) => <span>{word}</span>)}</div>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    background: var(--brand-orange);
    color: #fff;
    padding: 96px 0 0;
    overflow: hidden;
    font-family: var(--font-sans);
  }

  .cta__grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 48px;
    align-items: center;
    padding: 0 var(--gutter) 96px;
  }

  .cta__eyebrow {
    color: rgba(0, 0, 0, 0.75);
    margin: 0 0 28px;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.35);
    width: fit-content;
  }

  .cta__heading {
    margin: 0;
    text-transform: uppercase;
    display: flex;
    flex-direction: column;
    gap: 10px;
    line-height: 1;
  }

  .cta__light {
    font-size: clamp(26px, 3.4vw, 58px);
    font-weight: 200;
    letter-spacing: -0.01em;
  }

  .cta__bold {
    font-family: var(--font-condensed);
    font-weight: 800;
    font-size: clamp(44px, 7vw, 124px);
    line-height: 0.92;
  }
  /* The dot ends the SENTENCE, and the sentence now runs through all three
     lines, so it sits on the close line rather than the bold one. A dot after
     "COSTS MORE THAN" would read as a false full stop. */
  .cta__close::after {
    content: '';
    display: inline-block;
    width: 0.14em;
    height: 0.14em;
    margin-left: 0.06em;
    background: #000;
    border-radius: 999px;
  }

  .cta__close {
    font-size: clamp(26px, 3.4vw, 58px);
    font-weight: 200;
    color: rgba(0, 0, 0, 0.65);
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 44px;
  }

  .cta__phone {
    margin-left: 12px;
    font-weight: 600;
    font-size: clamp(18px, 1.6vw, 24px);
    color: #000;
    text-decoration: none;
    transition: color var(--dur-micro) ease;
  }
  .cta__phone:hover { color: rgba(0, 0, 0, 0.7); }

  /* The ghost pill's 13px label sits on the orange surface, where white is
     2.92:1. Black ink matches the block's existing secondary lines. The global
     .aps-btn-ghost stays white for dark surfaces; this overrides only here. */
  .cta :global(.aps-btn-ghost) {
    color: #000;
    border-color: rgba(0, 0, 0, 0.55);
  }
  .cta :global(.aps-btn-ghost:hover) {
    background: #000;
    color: #fff;
    border-color: #000;
  }

  /* ---- Rotating badge -------------------------------------------------- */
  .cta__badge {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: clamp(180px, 16vw, 240px);
    height: clamp(180px, 16vw, 240px);
    color: #000;
    transform: scale(1);
    transition: transform 300ms var(--ease-settle);
  }
  .cta__badge:hover { transform: scale(1.06); }

  .cta__badge-ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    animation: spinSlow 22s linear infinite;
  }
  .cta__badge-ring text {
    font-family: var(--font-sans);
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    fill: #000;
  }

  .cta__badge-core {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44%;
    height: 44%;
    border-radius: 999px;
    background: #000;
  }

  /* ---- Marquee --------------------------------------------------------- */
  .cta__marquee {
    border-top: 1px solid rgba(0, 0, 0, 0.25);
    padding: 18px 0;
  }
  .cta__marquee :global(.marquee__track) {
    font-weight: 200;
    font-size: 22px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.7);
  }

  @media (max-width: 760px) {
    .cta__grid { align-items: flex-start; }
  }
</style>
