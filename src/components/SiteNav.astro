---
/**
 * SiteNav header (STYLEGUIDE.md §4.2): white wordmark left, then
 * "EST. 1997" -> theme toggle -> hamburger at gap:28px.
 *
 * Header ONLY. The full-screen overlay lives in SiteMenu.astro, rendered by
 * BaseLayout as a direct child of <body>: it is `position: fixed`, and both
 * `.hero` (`overflow: hidden`) and `.page-root` (`overflow-x: clip`) clip fixed
 * descendants, which cropped the overlay to the hero and stranded the user with
 * no reachable close button.
 *
 * This component only needs to render the button that opens it.
 */
---

<header class="nav">
  <a href="/" class="nav__logo" aria-label="Alive ProStudios home">
    <img src="/assets/logo-full-white.svg" alt="Alive ProStudios" width="180" height="40" />
  </a>

  <div class="nav__right">
    <span class="nav__est t-eyebrow">Est. 1997</span>

    <button type="button" class="nav__theme" data-theme-toggle aria-label="Toggle light and dark mode">
      <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
      </svg>
      <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
    </button>

    <button type="button" class="nav__burger" data-menu-open aria-label="Open menu" aria-expanded="false" aria-controls="site-menu">
      <span></span><span></span>
    </button>
  </div>
</header>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28px var(--gutter);
  }

  .nav__logo { display: block; }
  .nav__logo img { height: 40px; width: auto; }

  .nav__right { display: flex; align-items: center; gap: 28px; }

  .nav__est { color: rgba(255, 255, 255, 0.75); }

  .nav__theme {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: none;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 999px;
    cursor: pointer;
    color: #fff;
    transition: border-color var(--dur-micro) ease;
  }
  .nav__theme:hover { border-color: var(--brand-orange); }

  /* Sun in light mode, moon in dark. */
  .nav__theme .icon-moon { display: none; }
  :global(body[data-theme='dark']) .nav__theme .icon-sun { display: none; }
  :global(body[data-theme='dark']) .nav__theme .icon-moon { display: block; }

  .nav__burger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 44px;
    height: 44px;
    padding: 8px 7px;
    background: none;
    border: none;
    cursor: pointer;
  }
  .nav__burger span {
    display: block;
    width: 30px;
    height: 3px;
    background: #fff;
  }
</style>

<script>
  // Theme toggle. The initial value is applied by an inline script in <head> so
  // there is no flash before hydration.
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const next = document.body.dataset.theme === 'dark' ? 'light' : 'dark';
    document.body.dataset.theme = next;
    try {
      localStorage.setItem('aps-theme', next);
    } catch {
      /* private mode: the toggle still works for this page view */
    }
  });
</script>
