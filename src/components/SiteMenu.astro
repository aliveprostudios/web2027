---
import { navItems } from '../lib/nav';

/**
 * Full-screen menu overlay (STYLEGUIDE.md §4.2).
 *
 * RENDERED BY BaseLayout AS A DIRECT CHILD OF <body>, deliberately outside
 * `.page-root` and `.hero`. It is `position: fixed`, and a fixed element is
 * clipped by an ancestor that establishes a clip: `.hero` sets
 * `overflow: hidden` and `.page-root` sets `overflow-x: clip`, which clips fixed
 * descendants by spec and does so aggressively in Safari. Nested inside those,
 * the overlay was cropped to the hero's box, leaving the close button
 * unreachable and the page apparently frozen.
 *
 * Keep it out here. Do not move it back inside the page shell.
 */
interface Props {
  /** Current route, used to mark the active row black. */
  active?: string;
}

const { active = '' } = Astro.props;
const items = await navItems();

const isActive = (url: string) => active === url || (url !== '/' && active.startsWith(`${url}/`));
---

<div class="menu" id="site-menu" data-menu hidden>
  <div class="menu__bar">
    <a href="/" class="menu__home" aria-label="Alive ProStudios home">
      <img src="/assets/logo-full-white.svg" alt="Alive ProStudios" width="180" height="40" />
    </a>
    <button type="button" class="menu__close" data-menu-close aria-label="Close menu">
      <span></span><span></span>
    </button>
  </div>

  <nav class="menu__nav" aria-label="Main">
    {
      items.map((item, i) => (
        <div class="menu__row">
          {item.children.length > 0 ? (
            <>
              <button
                type="button"
                class="menu__link menu__link--toggle"
                data-accordion={String(i)}
                aria-expanded="false"
                aria-controls={`menu-sub-${i}`}
              >
                <span class="menu__label-group">
                  <span class="menu__num">{item.num}</span>
                  <span class:list={['menu__label', item.pillar && 'menu__label--pillar', (isActive(item.url) || item.children.some((c) => isActive(c.url))) && 'is-active']}>
                    {item.label}
                  </span>
                  {item.pillar && (
                    <span class="menu__pillar">Pillar {item.pillar.n} of {item.pillar.of}</span>
                  )}
                </span>
                <span class="menu__glyph" aria-hidden="true">+</span>
              </button>
              <ul class="menu__sub" id={`menu-sub-${i}`} hidden>
                {item.children.map((child) => (
                  <li>
                    <a href={child.url} class:list={['menu__sublink', isActive(child.url) && 'is-active']}>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h14M13 6l6 6-6 6"></path>
                      </svg>
                      <span>{child.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </>
          ) : (
            <a href={item.url} class="menu__link">
              <span class="menu__label-group">
                <span class="menu__num">{item.num}</span>
                <span class:list={['menu__label', item.pillar && 'menu__label--pillar', isActive(item.url) && 'is-active']}>{item.label}</span>
                {item.pillar && (
                  <span class="menu__pillar">Pillar {item.pillar.n} of {item.pillar.of}</span>
                )}
              </span>
            </a>
          )}
        </div>
      ))
    }
  </nav>

  <div class="menu__foot">
    <span>Toronto, Canada</span>
    <a href="mailto:info@aliveprostudios.com">info@aliveprostudios.com</a>
  </div>
</div>

<style>
  .menu {
    position: fixed;
    inset: 0;
    z-index: var(--z-menu);
    background: var(--brand-orange);
    display: flex;
    flex-direction: column;
    animation: navFade 300ms var(--ease-settle) both;
  }
  .menu[hidden] { display: none; }

  .menu__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28px var(--gutter);
    flex: none;
  }
  .menu__home { display: block; }
  .menu__bar img { height: 40px; width: auto; }

  .menu__close {
    position: relative;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    cursor: pointer;
  }
  .menu__close span {
    position: absolute;
    left: 7px;
    top: 20px;
    width: 30px;
    height: 3px;
    background: #fff;
  }
  .menu__close span:first-child { transform: rotate(45deg); }
  .menu__close span:last-child { transform: rotate(-45deg); }

  .menu__nav {
    flex: 1;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    display: flex;
    flex-direction: column;
    padding: 16px var(--gutter) 24px;
  }

  .menu__row { border-bottom: 1px solid rgba(255, 255, 255, 0.25); }

  .menu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    padding: 16px 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    text-decoration: none;
    animation: navRise 500ms var(--ease-settle) both;
    transform: translateX(0);
    transition: transform var(--dur-move) var(--ease-settle);
  }
  .menu__link:hover { transform: translateX(8px); }

  /* Plain rows (Work, Resources, Contact) carry no +/- glyph, so space-between
     would push the label to the far edge. They sit left, like every other row. */
  a.menu__link { justify-content: flex-start; }

  /* `gap` here is the number-to-label spacing for EVERY row, plain and accordion
     alike, which is why the plain rows are wrapped in this group too. Tightened
     from 16px on 2026-09-07 to buy width back for the pillar tag on a phone.
     Wrapping is allowed so the tag drops to its own line rather than overflowing
     on the narrowest screens; INFRASTRUCTURE is the row that tests this. */
  .menu__label-group {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 10px;
    min-width: 0;
  }

  /* One treatment for both pieces of row metadata: the sequence number and the
     pillar tag. Javad's request 2026-09-07 — they should read as a single
     system rather than two sizes. Declared together on purpose, so changing one
     cannot silently leave the other behind. The sans faces carry the labels;
     mono carries the counting. */
  .menu__num,
  .menu__pillar {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.75);
    flex: none;
  }

  .menu__num { width: 24px; }

  /* 18px, down from 22px on 2026-09-07 to make room for the pillar tag beside
     the label. Measured rather than guessed: at 19px both FOUNDATION and
     INFRASTRUCTURE pushed their tag onto a second line at 320px, at 18px only
     INFRASTRUCTURE does, and 17px does not rescue it either, because fourteen
     uppercase characters with tracking are simply wider than the column. The
     group is allowed to wrap for exactly that row; nothing overflows. */
  .menu__label {
    font-family: var(--font-sans);
    font-weight: 200;
    font-size: 18px;
    line-height: 1.1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff;
  }
  /* Current page renders black in the orange menu (§8 states). */
  .menu__label.is-active { color: #000; }

  /* The four service pillars, bold against the light weight of every other row.
     Javad's request 2026-09-07: they were blending into Work, Case Studies,
     Alive Pro, Resources and Contact, and they are the service architecture.

     Keyed on BOTH classes, (0,2,0), rather than on `.menu__label--pillar` alone
     at (0,1,0). A single class would depend on source order to beat the
     `font-weight: 200` above, which is the kind of quiet specificity fight this
     project has already lost once on the buttons. */
  .menu__label.menu__label--pillar { font-weight: 700; }

  /* "Pillar 2 of 4". Mono, like the row numbers, because both are structural
     metadata rather than content: the sans faces carry the labels, mono carries
     the counting. Black on the orange ground is the house pairing at 7.2:1, so
     it stays legible at this size. */
  /* Caps come from CSS, not from the markup, so the DOM keeps "Pillar 1 of 4"
     in sentence case and a screen reader reads it as words rather than
     spelling out shouted capitals. */
  .menu__pillar { white-space: nowrap; }

  .menu__glyph {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: 22px;
    line-height: 1;
    color: #fff;
    flex: none;
  }

  .menu__sub {
    margin: 0 0 20px;
    padding: 0 0 0 40px;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    animation: navFade var(--dur-move) var(--ease-settle) both;
  }
  .menu__sub[hidden] { display: none; }

  .menu__sublink {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 16px;
    font-weight: 500;
    color: #fff;
    text-decoration: none;
    transform: translateX(0);
    transition: transform var(--dur-move) var(--ease-settle), color 250ms ease;
  }
  .menu__sublink:hover { color: #000; transform: translateX(6px); }
  .menu__sublink.is-active { color: #000; }
  .menu__sublink svg { flex: none; opacity: 0.7; }

  .menu__foot {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    justify-content: space-between;
    padding: 16px var(--gutter) 28px;
    flex: none;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.75);
  }
  .menu__foot a { color: rgba(0, 0, 0, 0.75); }
  .menu__foot a:hover { color: #000; }
</style>

<script>
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');

  function setMenu(open: boolean) {
    if (!menu) return;
    menu.hidden = !open;
    openBtn?.setAttribute('aria-expanded', String(open));

    // Lock scrolling on the ROOT element, not <body>. `body { overflow: hidden }`
    // does not lock the page at all when <html> is the scroll container, and it
    // deforms the body box, which is what left a blank band under the footer.
    document.documentElement.classList.toggle('is-menu-open', open);

    if (open) menu.querySelector<HTMLElement>('a, button')?.focus();
    else openBtn?.focus();
  }

  openBtn?.addEventListener('click', () => setMenu(true));
  menu?.querySelectorAll('[data-menu-close]').forEach((el) =>
    el.addEventListener('click', () => setMenu(false)),
  );

  /**
   * Focus containment for the open overlay.
   *
   * Everything else about this menu was already right: it is a body-level fixed
   * overlay, the scroll lock is on <html>, Escape closes, focus moves in on open
   * and returns to the burger on close. What was missing was a Tab loop, so
   * tabbing past the last item walked straight into the page behind the overlay
   * and reached the skip link. Found by the 2026-09-05 audit (finding S7).
   *
   * A cycle rather than `inert` on `.page-root`, because the overlay and the
   * skip link both live OUTSIDE `.page-root` (fixed descendants get clipped
   * inside it), so marking that subtree inert would not have contained either.
   *
   * Zero-size elements are excluded, which is what keeps the collapsed accordion
   * panels out of the loop; they stay in the DOM at `0fr` rather than hidden.
   */
  const FOCUSABLE =
    'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';

  function menuFocusables(): HTMLElement[] {
    if (!menu) return [];
    return [...menu.querySelectorAll<HTMLElement>(FOCUSABLE)].filter((el) => {
      const rect = el.getBoundingClientRect();
      return rect.width > 0 && rect.height > 0;
    });
  }

  document.addEventListener('keydown', (event) => {
    if (!menu || menu.hidden) return;

    if (event.key === 'Escape') {
      setMenu(false);
      return;
    }

    if (event.key !== 'Tab') return;

    const items = menuFocusables();
    if (items.length === 0) return;

    const first = items[0]!;
    const last = items[items.length - 1]!;
    const active = document.activeElement;

    // Focus is outside the overlay already: pull it back rather than letting
    // this Tab land somewhere behind it.
    if (!(active instanceof Node) || !menu.contains(active)) {
      event.preventDefault();
      (event.shiftKey ? last : first).focus();
      return;
    }

    if (event.shiftKey && active === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && active === last) {
      event.preventDefault();
      first.focus();
    }
  });

  // Never strand the user in a locked state: if the overlay is somehow hidden
  // while the lock is still on, drop the lock.
  window.addEventListener('pageshow', () => {
    if (menu?.hidden) document.documentElement.classList.remove('is-menu-open');
  });

  // Accordion: one section open at a time.
  const toggles = menu?.querySelectorAll<HTMLButtonElement>('[data-accordion]') ?? [];
  toggles.forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const id = toggle.getAttribute('aria-controls');
      const panel = id ? document.getElementById(id) : null;
      const willOpen = toggle.getAttribute('aria-expanded') !== 'true';

      toggles.forEach((other) => {
        const otherId = other.getAttribute('aria-controls');
        const otherPanel = otherId ? document.getElementById(otherId) : null;
        other.setAttribute('aria-expanded', 'false');
        if (otherPanel) otherPanel.hidden = true;
        const glyph = other.querySelector('.menu__glyph');
        if (glyph) glyph.textContent = '+';
      });

      if (willOpen) {
        toggle.setAttribute('aria-expanded', 'true');
        if (panel) panel.hidden = false;
        const glyph = toggle.querySelector('.menu__glyph');
        if (glyph) glyph.textContent = '−';
      }
    });
  });
</script>
