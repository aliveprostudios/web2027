---
/** Black footer bar (STYLEGUIDE.md §4.8). Theme-invariant. */
interface Props {
  backLabel?: string;
  backHref?: string;
  nextLabel?: string;
  nextHref?: string;
}

const {
  backLabel = 'Alive ProStudios',
  backHref = '/',
  nextLabel = 'All Services',
  nextHref = '/foundation',
} = Astro.props;
---

<footer class="foot">
  <a href={backHref}>&larr; {backLabel}</a>
  <span class="foot__centre">
    Alive ProStudios Inc. Toronto, Canada
    <a href="/privacy-policy" class="foot__legal">Privacy Policy</a>
  </span>
  <a href={nextHref}>{nextLabel} &rarr;</a>
</footer>

<style>
  .foot {
    position: relative;
    z-index: var(--z-content);
    background: #000;
    color: #fff;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    justify-content: space-between;
    align-items: center;
    padding: 32px var(--gutter);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .foot a { color: #fff; }
  .foot a:hover { color: var(--brand-orange); }
  .foot__centre {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
    color: rgba(255, 255, 255, 0.6);
  }
  /* Separator only when both sit on the same line. */
  .foot__legal { position: relative; }
  .foot__legal::before {
    content: '·';
    position: absolute;
    left: -12px;
    color: rgba(255, 255, 255, 0.35);
  }
  .foot span { color: rgba(255, 255, 255, 0.6); }
</style>
